{%- comment -%}
  Public part of the wholesale page: what Google and first-time visitors see without logging in.
  Wholesale prices stay hidden; designs link to their retail pages.
{%- endcomment -%}
{{ 'sufias-wholesale.css' | asset_url | stylesheet_tag }}
<section class="sw wseo" aria-labelledby="wseo-h">
  <div class="sw-section">
    <div class="sw-wrap">
      <div class="wseo-intro">
        <p class="sw-kicker">{{ section.settings.kicker | escape }}</p>
        <h2 class="sw-h2" id="wseo-h">{{ section.settings.heading | escape }}</h2>
        <div class="wseo-text">{{ section.settings.intro }}</div>
      </div>

      <ul class="wseo-points" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'point' -%}
            <li {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.text | escape }}</span></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>

  {%- comment -%}
    Coming soon: designs tagged booking + preview whose launch time is still ahead. Photos stay blurred and a
    countdown runs to the launch. With nothing scheduled, a "next drop" panel invites buyers to get notified.
  {%- endcomment -%}
  {%- liquid
    assign now_epoch = 'now' | date: '%s' | plus: 0
    assign soon_count = 0
    capture soon_cards
      paginate collections.all.products by 250
        for p in collections.all.products
          unless p.tags contains 'booking' and p.tags contains 'preview'
            continue
          endunless
          assign launch_at = p.metafields.custom.launch_date_time.value
          if launch_at != blank
            assign launch_epoch = launch_at | date: '%s' | plus: 0
            if launch_epoch <= now_epoch
              continue
            endif
          endif
          if soon_count >= 8
            break
          endif
          assign soon_count = soon_count | plus: 1
          echo '<li class="wseo-soon__card">'
          echo '<span class="wseo-soon__img">'
          if p.featured_image != blank
            echo p.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', alt: '', width: 360
          endif
          echo '<span class="wseo-soon__tag">Coming soon</span></span>'
          echo '<span class="wseo-soon__title">'
          echo p.title | escape
          echo '</span>'
          echo '<span class="wseo-soon__meta">'
          echo p.variants.size | append: ' colours'
          echo '</span>'
          if launch_at != blank
            echo '<span class="wseo-soon__when">Launch ' | append: launch_at | date: '%d %b, %l:%M %p' | append: '</span>'
            echo '<span class="wseo-soon__count" data-wseo-countdown="' | append: launch_epoch | append: '"></span>'
          endif
          echo '</li>'
        endfor
      endpaginate
    endcapture
    assign wa_text = 'Assalam o Alaikum, please send me the next wholesale design drop from Sufias Fashion.' | url_encode
  -%}
  <div class="sw-section sw-section--dark wseo-soon" data-wseo-upcoming aria-labelledby="wseo-soon-h">
    <div class="sw-wrap">
      <div class="wseo-head">
        <div><p class="sw-kicker">The next drop</p><h2 class="sw-h2" id="wseo-soon-h">Coming soon</h2></div>
        <p class="wseo-soon__lead">{% if soon_count > 0 %}New designs launching shortly. Approved buyers can order the moment each one goes live.{% else %}Fresh embroidered designs are added every week. Get the next drop on WhatsApp before it goes live.{% endif %}</p>
      </div>
      {%- if soon_count > 0 -%}
        <ul class="wseo-soon__grid" role="list">{{ soon_cards }}</ul>
      {%- else -%}
        <div class="wseo-soon__empty">
          <ul class="wseo-soon__steps" role="list">
            <li><strong>Every week</strong><span>New winter, lawn and abaya designs</span></li>
            <li><strong>First look</strong><span>Approved buyers see each drop before launch</span></li>
            <li><strong>Every colour</strong><span>Order 10 to 24 suits per design, colours mixed</span></li>
          </ul>
        </div>
      {%- endif -%}
      <p class="wseo-soon__cta">
        <a class="sw-btn wseo-soon__wa" href="https://wa.me/923014509210?text={{ wa_text }}" target="_blank" rel="noopener">Notify me on WhatsApp</a>
      </p>
    </div>
  </div>

  {%- liquid
    assign shown = 0
    assign max_designs = section.settings.designs | default: 12
  -%}
  <div class="sw-section sw-section--soft" data-wseo-designs>
    <div class="sw-wrap">
      <div class="wseo-head">
        <div><p class="sw-kicker">Latest designs</p><h2 class="sw-h2">{{ section.settings.designs_heading | escape }}</h2></div>
        <p class="sw-muted">{{ section.settings.designs_note | escape }}</p>
      </div>
      <ul class="wseo-grid" role="list">
        {%- paginate collections.all.products by 250 -%}
          {%- assign wseo_newest = collections.all.products | sort: 'created_at' | reverse -%}
          {%- for p in wseo_newest -%}
            {%- if shown >= max_designs -%}{%- break -%}{%- endif -%}
            {%- unless p.tags contains 'booking' -%}{%- continue -%}{%- endunless -%}
            {%- if p.tags contains 'preview' or p.featured_image == blank -%}{%- continue -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            {%- assign alt = p.title | append: ' – wholesale embroidered suit' -%}
            <li class="wseo-card">
              <a href="{{ p.url }}" class="wseo-card__link">
                <span class="wseo-card__img">
                  {{ p.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw', alt: alt }}
                </span>
                <span class="wseo-card__title">{{ p.title | escape }}</span>
                <span class="wseo-card__meta">{{ p.variants.size }} colour{% if p.variants.size != 1 %}s{% endif %} · Min. 10 suits per design</span>
              </a>
            </li>
          {%- endfor -%}
        {%- endpaginate -%}
      </ul>
      <p class="wseo-cta">
        {%- if customer -%}
          <a class="sw-btn sw-btn--primary" href="#">See wholesale prices above</a>
        {%- else -%}
          <a class="sw-btn sw-btn--primary" href="{{ routes.account_register_url }}">Create a free account</a>
          <a class="sw-btn sw-btn--outline" href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}">Log in for wholesale prices</a>
        {%- endif -%}
      </p>
    </div>
  </div>

  <div class="sw-section">
    <div class="sw-wrap wseo-cols">
      <div>
        <p class="sw-kicker">How it works</p>
        <h2 class="sw-h2">{{ section.settings.steps_heading | escape }}</h2>
        <ol class="wseo-steps">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              <li {{ block.shopify_attributes }}><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.text | escape }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>
      <div>
        <p class="sw-kicker">Questions</p>
        <h2 class="sw-h2">Wholesale FAQ</h2>
        <div class="wseo-faq">
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq' -%}
              <details {{ block.shopify_attributes }}>
                <summary>{{ block.settings.question | escape }}</summary>
                <p>{{ block.settings.answer | escape }}</p>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Structured data so search engines understand the business and the FAQ. {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": ["ClothingStore", "WholesaleStore"],
        "@id": {{ shop.url | append: '/#wholesale' | json }},
        "name": {{ shop.name | strip | json }},
        "url": {{ shop.url | append: page.url | json }},
        "description": {{ section.settings.intro | strip_html | strip | json }},
        "telephone": {{ section.settings.phone | json }},
        "email": {{ shop.email | json }},
        "priceRange": "Rs",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": {{ section.settings.street | json }},
          "addressLocality": "Lahore",
          "postalCode": "54000",
          "addressCountry": "PK"
        },
        "areaServed": "PK"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {%- assign first = true -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'faq' -%}
              {%- unless first -%},{%- endunless -%}{%- assign first = false -%}
              {"@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ block.settings.answer | json }}}}
            {%- endif -%}
          {%- endfor -%}
        ]
      }
    ]
  }
  </script>

  <script>
    (function () {
      var items = document.querySelectorAll('[data-wseo-countdown]');
      if (!items.length) return;
      function pad(n) { return (n < 10 ? '0' : '') + n; }
      function tick() {
        var now = Date.now() / 1000, pending = 0;
        items.forEach(function (el) {
          var left = Math.floor(Number(el.getAttribute('data-wseo-countdown')) - now);
          if (left <= 0) { el.textContent = 'Live now'; return; }
          pending++;
          var d = Math.floor(left / 86400), h = Math.floor(left % 86400 / 3600), m = Math.floor(left % 3600 / 60), s = left % 60;
          el.textContent = (d ? d + 'd ' : '') + pad(h) + 'h ' + pad(m) + 'm ' + pad(s) + 's';
        });
        if (pending) setTimeout(tick, 1000);
      }
      tick();
    })();
  </script>

  <style>
    .wseo .sw-h2{margin:0 0 12px}
    .wseo-intro{max-width:780px}
    .wseo-text{color:var(--sw-ink-2);font-size:16px;line-height:1.7}
    .wseo-text p{margin:0 0 12px}
    .wseo-points{list-style:none;margin:24px 0 0;padding:0;display:grid;gap:12px;grid-template-columns:repeat(4,minmax(0,1fr))}
    .wseo-points li{display:grid;gap:4px;padding:16px;border:1px solid var(--sw-line);border-radius:var(--sw-radius);background:var(--sw-surface)}
    .wseo-points span{color:var(--sw-muted);font-size:14px}
    .wseo-head{display:flex;align-items:flex-end;justify-content:space-between;gap:12px 24px;flex-wrap:wrap;margin-bottom:20px}
    .wseo-head .sw-muted{max-width:420px}
    .wseo-grid{list-style:none;margin:0;padding:0;display:grid;gap:clamp(12px,2vw,20px);grid-template-columns:repeat(4,minmax(0,1fr))}
    .wseo-card__link{display:grid;gap:6px;color:inherit;text-decoration:none}
    .wseo-card__img{display:block;aspect-ratio:4/5;border-radius:var(--sw-radius);overflow:hidden;background:#ece7df}
    .wseo-card__img img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
    .wseo-card__link:hover img{transform:scale(1.04)}
    .wseo-card__title{font-weight:600;line-height:1.3}
    .wseo-card__meta{font-size:13px;color:var(--sw-muted)}
    .wseo-cta{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin:28px 0 0}
    .wseo-cols{display:grid;gap:32px;grid-template-columns:repeat(2,minmax(0,1fr))}
    .wseo-steps{margin:0;padding:0;list-style:none;counter-reset:s;display:grid;gap:14px}
    .wseo-steps li{counter-increment:s;display:grid;grid-template-columns:36px 1fr;gap:2px 12px}
    .wseo-steps li::before{content:counter(s);grid-row:1/3;display:grid;place-items:center;width:36px;height:36px;border-radius:50%;background:var(--sw-ink);color:#fff;font-weight:700}
    .wseo-steps span{color:var(--sw-muted)}
    .wseo-faq details{border-bottom:1px solid var(--sw-line)}
    .wseo-faq summary{cursor:pointer;min-height:48px;display:flex;align-items:center;font-weight:600;padding:8px 0}
    .wseo-faq p{margin:0 0 14px;color:var(--sw-ink-2)}
    .wseo-soon[hidden]{display:none!important}
    .wseo-soon{position:relative;overflow:hidden;background:radial-gradient(120% 140% at 85% 0%,#3a2f22 0%,var(--sw-ink-2) 55%,#171613 100%)}
    .wseo-soon .sw-h2{color:#fff}
    .wseo-soon__lead{max-width:440px;margin:0;color:rgb(255 255 255 / 72%);font-size:15px;line-height:1.6}
    .wseo-soon__grid{list-style:none;margin:0;padding:0;display:grid;gap:clamp(12px,2vw,20px);grid-template-columns:repeat(4,minmax(0,1fr))}
    .wseo-soon__card{display:grid;gap:6px;min-width:0}
    .wseo-soon__img{position:relative;display:block;aspect-ratio:4/5;border-radius:var(--sw-radius);overflow:hidden;background:#2f2a23;border:1px solid rgb(201 169 110 / 35%)}
    .wseo-soon__img img{width:100%;height:100%;object-fit:cover;filter:blur(14px) saturate(1.1);transform:scale(1.15)}
    .wseo-soon__tag{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);padding:8px 14px;border-radius:999px;background:rgb(23 22 19 / 72%);border:1px solid rgb(201 169 110 / 60%);color:#e7d3a8;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;white-space:nowrap}
    .wseo-soon__title{font-weight:600;line-height:1.3;color:#fff;overflow-wrap:anywhere}
    .wseo-soon__meta,.wseo-soon__when{font-size:13px;color:rgb(255 255 255 / 65%)}
    .wseo-soon__count{display:inline-flex;align-self:start;padding:4px 10px;border-radius:999px;background:#c9a96e;color:#1d1c1a;font-size:13px;font-weight:700;font-variant-numeric:tabular-nums}
    .wseo-soon__count:empty{display:none}
    .wseo-soon__empty{border:1px solid rgb(201 169 110 / 30%);border-radius:16px;background:rgb(255 255 255 / 4%);padding:clamp(16px,3vw,28px)}
    .wseo-soon__steps{list-style:none;margin:0;padding:0;display:grid;gap:16px;grid-template-columns:repeat(3,minmax(0,1fr))}
    .wseo-soon__steps li{display:grid;gap:4px;padding-left:14px;border-left:2px solid #c9a96e}
    .wseo-soon__steps strong{color:#fff;font-size:16px}
    .wseo-soon__steps span{color:rgb(255 255 255 / 70%);font-size:14px;line-height:1.5}
    .wseo-soon__cta{margin:24px 0 0;display:flex;justify-content:center}
    .wseo-soon__wa{min-height:48px;padding:0 24px;background:#c9a96e;color:#1d1c1a;border-color:#c9a96e;font-weight:700}
    .wseo-soon__wa:hover{background:#fff;border-color:#fff;color:#1d1c1a}
    @media (max-width:989px){.wseo-soon__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
    @media (max-width:560px){.wseo-soon__steps{grid-template-columns:1fr}.wseo-soon__wa{flex:1 1 100%}.wseo-soon__tag{font-size:10px;padding:6px 10px}}
    @media (max-width:989px){.wseo-points,.wseo-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.wseo-cols{grid-template-columns:1fr}}
    @media (max-width:560px){.wseo-points{grid-template-columns:1fr}.wseo-cta .sw-btn{flex:1 1 100%}}
  </style>
</section>

{% schema %}
{
  "name": "Wholesale SEO content",
  "tag": "div",
  "settings": [
    {"type": "text", "id": "kicker", "label": "Small heading", "default": "Wholesale from Lahore"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Wholesale embroidered suits for boutiques and resellers"},
    {"type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Sufias Fashion supplies wholesale embroidered 3-piece suits to boutiques, online sellers and retailers across Pakistan. Choose from winter cotton, khaddar, lawn, chiffon and organza designs with chikankari, thread and cutwork embroidery, in every colour of each design.</p><p>Order 10 to 24 suits per design, mix colours freely, and pay by bank transfer. We pack and ship from Lahore to every city in Pakistan.</p>"},
    {"type": "range", "id": "designs", "label": "Designs to show", "min": 4, "max": 24, "step": 4, "default": 12},
    {"type": "text", "id": "designs_heading", "label": "Designs heading", "default": "Embroidered suits available in wholesale"},
    {"type": "text", "id": "designs_note", "label": "Designs note", "default": "Wholesale prices are shown to approved buyers after logging in."},
    {"type": "text", "id": "steps_heading", "label": "Steps heading", "default": "Order wholesale suits in 4 steps"},
    {"type": "text", "id": "phone", "label": "Business phone (for Google)", "default": "+92 301 4509210"},
    {"type": "text", "id": "street", "label": "Street address (for Google)", "default": "Plot 500, Pindi Stop, Maulana Shaukat Ali Road, Kot Lakhpat"}
  ],
  "blocks": [
    {"type": "point", "name": "Highlight", "settings": [{"type": "text", "id": "title", "label": "Title"}, {"type": "text", "id": "text", "label": "Text"}]},
    {"type": "step", "name": "Step", "settings": [{"type": "text", "id": "title", "label": "Title"}, {"type": "text", "id": "text", "label": "Text"}]},
    {"type": "faq", "name": "FAQ", "settings": [{"type": "text", "id": "question", "label": "Question"}, {"type": "textarea", "id": "answer", "label": "Answer"}]}
  ],
  "presets": [{"name": "Wholesale SEO content"}]
}
{% endschema %}
