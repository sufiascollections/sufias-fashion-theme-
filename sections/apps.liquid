<div class="{% if section.settings.include_margins %}t4s-container{% endif %}"{% if settings.animations_reveal_on_scroll %} hdt-reveal="fade-in"{% endif %}>
  {%- for block in section.blocks -%}
    {%- capture app_content -%}{%- render block -%}{%- endcapture -%}
    {%- if app_content contains 'instafeed_app_block' and request.design_mode == false -%}
      <div data-sufias-instafeed aria-busy="true" style="min-height: 240px">
        <template data-sufias-instafeed-template>
          {{- app_content -}}
        </template>
        <noscript>{{- app_content -}}</noscript>
      </div>
    {%- else -%}
      {{- app_content -}}
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "App",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "include_margins",
      "default": true,
      "label": "Make section margins the same as theme"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "App"
    }
  ]
}
{% endschema %}


