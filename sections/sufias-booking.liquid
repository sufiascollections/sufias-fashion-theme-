{%- liquid
  assign sid = section.id
  assign request_form_id = 'SufiasBookingRequest-' | append: sid
-%}

{{ 'sufias-booking.css' | asset_url | stylesheet_tag }}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet">

<div id="SufiasBookingCatalog-{{ sid }}" class="sf-booking-catalog" data-booking-catalog>
  <nav class="sfbc-toolbar" aria-label="Booking collection navigation">
    <div class="sfbc-menu">
      <a href="#sfbc-coming-{{ sid }}">Coming Soon</a>
      <a href="#sfbc-previous-{{ sid }}">Previous Arrivals</a>
    </div>
    <label class="sfbc-search">
      <span class="sfbc-visually-hidden">Search previous arrivals</span>
      <input type="search" placeholder="Search products..." autocomplete="off" data-booking-search>
    </label>
    <div class="sfbc-nav-actions">
      <a class="sfbc-navlink" href="{{ routes.account_url }}">Orders</a>
      <a class="sfbc-icon-link" href="{{ routes.account_login_url }}" aria-label="Account">&#9786;</a>
      <a class="sfbc-icon-link" href="{{ routes.cart_url }}" aria-label="Store cart">&#128722;<span class="sfbc-badge">{{ cart.item_count }}</span></a>
      <button class="sfbc-request-bag" type="button" data-open-request aria-label="Open request list">
        Request list <span class="sfbc-badge" data-request-count>0</span>
      </button>
    </div>
  </nav>

  {% paginate collections.all.products by 250 %}
    <section class="sfbc-upcoming" id="sfbc-coming-{{ sid }}" aria-labelledby="sfbc-coming-title-{{ sid }}">
      <div class="sfbc-section-head">
        <div><div class="sfbc-kicker">The Next Drops</div><h1 id="sfbc-coming-title-{{ sid }}">Coming Soon</h1></div>
        <div class="sfbc-head-note">
          <div class="sfbc-drop-note"><span class="sfbc-drop-dot" aria-hidden="true"></span>Drops are limited</div>
          <p>Launch times are set on each product. Coming soon styles cannot be booked or purchased yet.</p>
        </div>
      </div>
      <div class="sfbc-grid" data-coming-grid>
        {% for booking_product in collections.all.products %}
          {% if booking_product.tags contains 'booking' and booking_product.tags contains 'preview' %}
            {% assign booking_launch_at = booking_product.metafields.custom.launch_date_time.value %}
            {% assign booking_launch_epoch = booking_launch_at | date: '%s' | plus: 0 %}
            {% assign booking_now_epoch = 'now' | date: '%s' | plus: 0 %}
            {% if booking_launch_at != blank and booking_launch_epoch > booking_now_epoch %}
              {% render 'sufias-booking-product-card', product: booking_product, card_type: 'upcoming' %}
            {% endif %}
          {% endif %}
        {% endfor %}
        <div class="sfbc-no-results" data-empty-coming hidden>No upcoming styles right now.</div>
      </div>
    </section>

    <section class="sfbc-archive" id="sfbc-previous-{{ sid }}" aria-labelledby="sfbc-previous-title-{{ sid }}">
      <div class="sfbc-section-head">
        <div><div class="sfbc-kicker">Archive</div><h2 id="sfbc-previous-title-{{ sid }}">Previous Arrivals</h2></div>
        <p>In-stock styles from earlier drops.</p>
      </div>
      <div class="sfbc-grid" data-previous-grid>
        {% for booking_product in collections.all.products %}
          {% if booking_product.tags contains 'booking' %}
            {% unless booking_product.tags contains 'preview' %}
                {% render 'sufias-booking-product-card', product: booking_product, card_type: 'archive' %}
            {% endunless %}
          {% endif %}
        {% endfor %}
        <div class="sfbc-no-results" data-no-results hidden>No matching products.</div>
        <div class="sfbc-no-results" data-empty-previous hidden>No in-stock previous arrivals right now.</div>
      </div>
    </section>
  {% endpaginate %}
  <div class="sfbc-modal" data-quick-modal hidden>
    <div class="sfbc-sheet sfbc-sheet--quick" role="dialog" aria-modal="true" aria-labelledby="sfbc-quick-name-{{ sid }}">
      <button class="sfbc-close" type="button" data-close-modal aria-label="Close">&times;</button>
      <div class="sfbc-quick-image"><img data-quick-image src="" alt=""></div>
      <div class="sfbc-quick-body">
        <div class="sfbc-kicker" data-quick-tag></div><h2 id="sfbc-quick-name-{{ sid }}" data-quick-name></h2>
        <div class="sfbc-card-price" data-quick-price></div>
        <div class="sfbc-availability-note">Select an option and quantity to add this item to your Shopify cart.</div>
        <form class="sfbc-cart-form" action="{{ routes.cart_add_url }}" method="post" data-shopify-cart-form>
          <label>Product variant</label>
          <select class="sfbc-variant-select" data-variant-select aria-label="Product variant"></select>
          <label>Quantity</label>
          <div class="sfbc-quantity"><button type="button" data-single-step="-1" aria-label="Decrease quantity">−</button><span data-single-quantity>1</span><button type="button" data-single-step="1" aria-label="Increase quantity">+</button></div>
          <input type="hidden" name="id" value="" data-cart-variant>
          <input type="hidden" name="quantity" value="1" data-cart-quantity>
          <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
          <div class="sfbc-total"><span>Subtotal</span><strong data-quick-total></strong></div>
          <button class="sfbc-button sfbc-button--full" type="submit" name="add">Add to cart</button>
        </form>
        <button class="sfbc-request-secondary" type="button" data-add-request>Add to booking request list</button>
      </div>
    </div>
  </div>

  <div class="sfbc-modal" data-request-modal hidden>
    <div class="sfbc-sheet sfbc-sheet--request" role="dialog" aria-modal="true" aria-labelledby="sfbc-request-title-{{ sid }}">
      <button class="sfbc-close" type="button" data-close-modal aria-label="Close">&times;</button>
      <div class="sfbc-kicker">Order request</div><h2 id="sfbc-request-title-{{ sid }}">Your request list</h2>
      <div data-request-lines></div>
      <div class="sfbc-empty" data-request-empty>Your request list is empty.</div>
      <div class="sfbc-error" role="alert" data-submit-error tabindex="-1" hidden>Please add a suit to your request list before sending.</div>
      <div class="sfbc-total sfbc-total--request" data-request-total hidden><span>Estimated total</span><strong data-request-total-value></strong></div>
      {% form 'contact', id: request_form_id, class: 'sfbc-request-form' %}
        {% if form.posted_successfully? %}<div class="sfbc-success" role="status" data-request-success><strong>Request sent.</strong><span>Thank you. Our team will contact you to confirm availability and final pricing.</span></div>{% endif %}
        {% if form.errors %}<div class="sfbc-error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
        <input type="hidden" name="contact[subject]" value="Sufias Fashion order request">
        <input type="hidden" name="contact[tags]" value="booking page, order request">
        <textarea class="sfbc-hidden-message" name="contact[body]" data-request-message hidden></textarea>
        <div class="sfbc-form-grid">
          <div><label for="sfbc-name-{{ sid }}">Full name</label><input id="sfbc-name-{{ sid }}" name="contact[name]" type="text" autocomplete="name" required></div>
          <div><label for="sfbc-phone-{{ sid }}">Phone number</label><input id="sfbc-phone-{{ sid }}" name="contact[phone]" type="tel" autocomplete="tel" required></div>
          <div><label for="sfbc-email-{{ sid }}">Email address (optional)</label><input id="sfbc-email-{{ sid }}" name="contact[email]" type="email" autocomplete="email"></div>
          <div><label for="sfbc-city-{{ sid }}">City</label><input id="sfbc-city-{{ sid }}" name="contact[city]" type="text" autocomplete="address-level2"></div>
          <div><label for="sfbc-date-{{ sid }}">Preferred booking date</label><input id="sfbc-date-{{ sid }}" name="booking[preferred_date]" type="date"></div>
          <div><label for="sfbc-time-{{ sid }}">Preferred booking time</label><input id="sfbc-time-{{ sid }}" name="booking[preferred_time]" type="time"></div>
          <div class="sfbc-form-wide"><label for="sfbc-address-{{ sid }}">Address / notes</label><textarea id="sfbc-address-{{ sid }}" name="contact[address]" rows="3" autocomplete="street-address"></textarea></div>
        </div>
        <button class="sfbc-button sfbc-button--full" type="submit" data-submit-request>Send order request</button>
        <p class="sfbc-form-note">This sends an inquiry to Sufias Fashion. It does not take payment or place a confirmed order.</p>
      {% endform %}
    </div>
  </div>

  <div class="sfbc-toast" role="status" aria-live="polite" data-booking-toast></div>
</div>

<script src="{{ 'sufias-booking.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Sufias Booking",
  "tag": "section",
  "class": "t4s-section sufias-booking-section",
  "settings": [],
  "presets": [
    {
      "name": "Sufias Booking"
    }
  ]
}
{% endschema %}
