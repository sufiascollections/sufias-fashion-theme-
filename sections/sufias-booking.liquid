{%- liquid
  assign sid = section.id
-%}
<section id="SufiasBooking-{{ sid }}" class="sufias-booking">
  <div class="sufias-booking__inner">
    <div class="sufias-booking__intro">
      <div class="sufias-booking__kicker">BOOKING</div>
      <h1>{{ section.settings.heading }}</h1>
      <p>{{ section.settings.subheading }}</p>
    </div>

    {%- form 'contact', id: 'SufiasBookingForm-' | append: sid, class: 'sufias-booking__form' -%}
      {%- if form.posted_successfully? -%}
        <div class="sufias-booking__success" role="status">
          <strong>Booking request received.</strong>
          <span>Thank you. We’ll contact you to confirm the details.</span>
        </div>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="sufias-booking__error" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="sufias-booking__grid">
        <div class="sufias-booking__field">
          <label for="BookingName-{{ sid }}">Full name</label>
          <input id="BookingName-{{ sid }}" type="text" name="contact[name]" value="{{ form.name | default: customer.name }}" autocomplete="name" required>
        </div>
        <div class="sufias-booking__field">
          <label for="BookingPhone-{{ sid }}">Phone number</label>
          <input id="BookingPhone-{{ sid }}" type="tel" name="contact[phone]" value="{{ form.phone | default: customer.phone }}" autocomplete="tel" required>
        </div>
        <div class="sufias-booking__field">
          <label for="BookingEmail-{{ sid }}">Email address</label>
          <input id="BookingEmail-{{ sid }}" type="email" name="contact[email]" value="{{ form.email | default: customer.email }}" autocomplete="email" required>
        </div>
        <div class="sufias-booking__field">
          <label for="BookingDate-{{ sid }}">Booking date</label>
          <input id="BookingDate-{{ sid }}" type="date" name="contact[booking_date]" required>
        </div>
        <div class="sufias-booking__field">
          <label for="BookingTime-{{ sid }}">Preferred time</label>
          <input id="BookingTime-{{ sid }}" type="time" name="contact[preferred_time]" required>
        </div>
        <div class="sufias-booking__field">
          <label for="BookingType-{{ sid }}">Booking type</label>
          <select id="BookingType-{{ sid }}" name="contact[booking_type]" required>
            <option value="" selected disabled>Select booking type</option>
            <option value="Personal styling">Personal styling</option>
            <option value="Private shopping">Private shopping</option>
            <option value="Order consultation">Order consultation</option>
            <option value="Other">Other</option>
          </select>
        </div>
      </div>

      <div class="sufias-booking__field sufias-booking__field--full">
        <label for="BookingMessage-{{ sid }}">Message / notes</label>
        <textarea id="BookingMessage-{{ sid }}" name="contact[body]" rows="7" placeholder="Tell us anything we should know about your booking.">{{ form.body }}</textarea>
      </div>

      <button class="sufias-booking__button" type="submit">{{ section.settings.button_text }}</button>
      <p class="sufias-booking__note">We’ll review your request and contact you to confirm availability.</p>
    {%- endform -%}
  </div>
</section>

<style>
#SufiasBooking-{{ sid }}{
  --sb-ink:#000;
  --sb-paper:#fff;
  --sb-muted:#6b6b6b;
  --sb-line:#d9d9d9;
  background:var(--sb-paper);
  color:var(--sb-ink);
  font-family:"DM Sans",sans-serif;
  padding:70px 5%;
}
#SufiasBooking-{{ sid }} *{box-sizing:border-box}
#SufiasBooking-{{ sid }} .sufias-booking__inner{width:min(920px,100%);margin:0 auto}
#SufiasBooking-{{ sid }} .sufias-booking__intro{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:38px;flex-wrap:wrap}
#SufiasBooking-{{ sid }} .sufias-booking__kicker{font-size:11px;text-transform:uppercase;letter-spacing:.2em;color:var(--sb-muted);margin-bottom:10px}
#SufiasBooking-{{ sid }} h1{font-family:"Playfair Display",serif;font-weight:500;font-size:clamp(34px,6vw,58px);line-height:1;margin:0}
#SufiasBooking-{{ sid }} .sufias-booking__intro p{max-width:360px;color:var(--sb-muted);font-size:13px;line-height:1.7;margin:0}
#SufiasBooking-{{ sid }} .sufias-booking__form{border:1px solid var(--sb-line);padding:34px}
#SufiasBooking-{{ sid }} .sufias-booking__grid{display:grid;grid-template-columns:1fr 1fr;gap:0 18px}
#SufiasBooking-{{ sid }} .sufias-booking__field{margin-bottom:20px}
#SufiasBooking-{{ sid }} label{display:block;font-size:10px;text-transform:uppercase;letter-spacing:.14em;color:var(--sb-muted);margin:0 0 8px}
#SufiasBooking-{{ sid }} input,#SufiasBooking-{{ sid }} select,#SufiasBooking-{{ sid }} textarea{width:100%;border:1px solid var(--sb-line);border-radius:0;background:#fff;color:#000;font:inherit;font-size:14px;padding:0 14px;box-shadow:none}
#SufiasBooking-{{ sid }} input,#SufiasBooking-{{ sid }} select{height:48px}
#SufiasBooking-{{ sid }} textarea{padding:14px;resize:vertical;min-height:150px}
#SufiasBooking-{{ sid }} input:focus,#SufiasBooking-{{ sid }} select:focus,#SufiasBooking-{{ sid }} textarea:focus{outline:0;border-color:#000}
#SufiasBooking-{{ sid }} .sufias-booking__button{width:100%;height:48px;border:0;border-radius:2px;background:#000;color:#fff;font:inherit;font-size:11px;text-transform:uppercase;letter-spacing:.14em;cursor:pointer;transition:.25s}
#SufiasBooking-{{ sid }} .sufias-booking__button:hover{background:#333}
#SufiasBooking-{{ sid }} .sufias-booking__note{text-align:center;color:var(--sb-muted);font-size:11px;margin:14px 0 0}
#SufiasBooking-{{ sid }} .sufias-booking__success{display:flex;flex-direction:column;gap:4px;border:1px solid #000;padding:16px;margin-bottom:24px;font-size:13px}
#SufiasBooking-{{ sid }} .sufias-booking__error{border:1px solid #9c3a2e;padding:14px;margin-bottom:24px;color:#9c3a2e;font-size:12px}
@media(max-width:600px){
  #SufiasBooking-{{ sid }}{padding:48px 5%}
  #SufiasBooking-{{ sid }} .sufias-booking__form{padding:22px 18px}
  #SufiasBooking-{{ sid }} .sufias-booking__grid{grid-template-columns:1fr;gap:0}
  #SufiasBooking-{{ sid }} .sufias-booking__intro{display:block}
  #SufiasBooking-{{ sid }} .sufias-booking__intro p{margin-top:14px}
}
</style>

{% schema %}
{
  "name": "Sufias Booking",
  "tag": "section",
  "class": "t4s-section sufias-booking-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Book an Appointment"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Request a private appointment with Sufias Fashion. Choose your preferred date and time and we’ll confirm availability."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Request Booking"
    }
  ],
  "presets": [
    {
      "name": "Sufias Booking"
    }
  ]
}
{% endschema %}