{{ 'sufias-booking-launch.css' | asset_url | stylesheet_tag }}
{{ 'sufias-ledger-cream.css' | asset_url | stylesheet_tag }}
<section class="sf-booking-catalog" data-wholesale><nav aria-label="Wholesale account" style="padding:16px 24px;text-align:right"><a class="sf-ledger-button" href="/pages/ledger" style="display:inline-block;background:#e8dcc6;color:#332a1e;padding:12px 24px;border-radius:8px;text-decoration:none">My Ledger / Mera Khata</a></nav>
  <div class="sf-ledger" data-wholesale-gate>
    <p class="sf-ledger-kicker">SUFIAS FASHION / WHOLESALE</p><h1>Wholesale collection</h1>
    {% if customer %}
      <p>{{ customer.name | escape }}</p><p data-wholesale-status role="status" aria-live="polite">Checking wholesale access…</p>
      <form data-wholesale-apply hidden><h2>Request wholesale access</h2><p>Wholesale is for bulk buyers approved by Sufias Fashion.</p><label>Your name<input name="name" value="{{ customer.name | escape }}" maxlength="150" required></label><label>Business / shop name<input name="business" maxlength="200" minlength="2" required></label><label>Phone / WhatsApp<input name="phone" value="{{ customer.phone | escape }}" maxlength="40" minlength="6" required></label><button type="submit">Request owner approval</button></form>
      <form data-wholesale-unlock hidden><h2>Open wholesale collection</h2><label>Your PIN<input name="pin" type="password" inputmode="numeric" pattern="[0-9]{6,12}" autocomplete="current-password" required></label><button type="submit">Unlock wholesale</button><a class="sf-ledger-button" href="/pages/ledger">Forgot PIN?</a></form>
    {% else %}
      <p>Log in to request wholesale access. Registration alone does not unlock wholesale prices.</p><a class="sf-ledger-button" href="{{ routes.storefront_login_url | escape }}">Log in / Register</a>
    {% endif %}
  </div>
  {% if customer %}
  <div data-wholesale-content hidden>
    <nav class="sfbc-toolbar"><a href="/pages/ledger">My ledger</a><a href="#wholesale-bag">Bulk request list</a><button type="button" data-wholesale-lock>Lock wholesale</button></nav>
    <section class="sfbc-upcoming" data-upcoming-section hidden><div class="sfbc-section-head"><div><div class="sfbc-kicker">The Next Drops</div><h1>Coming Soon</h1></div></div><div class="sfbc-grid" data-wholesale-upcoming></div></section>
    <section class="sfbc-archive"><div class="sfbc-section-head"><div><div class="sfbc-kicker">Wholesale collection</div><h2>Previous Article</h2></div><p>Choose a design, colours and quantities for your bulk request.</p></div><div class="sfbc-grid" data-wholesale-products></div></section>
    <div class="sf-ledger" id="wholesale-bag"><h2>Your bulk request</h2><p data-wholesale-bag>Choose products above.</p><p>Minimum 2 suits per design; mix colours within a design. Stock and delivery are confirmed by Sufias Fashion.</p><label>Notes<textarea data-wholesale-note maxlength="1000" rows="3"></textarea></label><button type="button" data-wholesale-submit>Send bulk request</button><p data-wholesale-order-status role="status" aria-live="polite"></p></div>
  </div>
  <script src="{{ 'sufias-wholesale-secure.js' | asset_url }}" defer></script>
  {% endif %}
</section>
<style>[data-wholesale] [hidden]{display:none!important}[data-wholesale] img{width:100%;aspect-ratio:4/5;object-fit:cover}[data-wholesale] .sfbc-card-body input{max-width:95px;padding:8px;border:1px solid #b8ad9b}[data-wholesale] .sfbc-card-body label{display:flex;justify-content:space-between;align-items:center;gap:10px;margin:12px 0}[data-wholesale] .sfbc-card-body label span{overflow-wrap:anywhere}[data-wholesale] .sfbc-toolbar button{background:#e8dcc6;border:0;padding:12px;color:#332a1e}[data-wholesale] textarea{width:100%;box-sizing:border-box;border:1px solid #b8ad9b;padding:12px}</style>
{% schema %}{"name":"Sufias Booking","tag":"section","class":"t4s-section sufias-booking-section","settings":[{"type":"checkbox","id":"ledger_enabled","label":"Save bookings to connected khata backend","default":true}],"presets":[{"name":"Sufias Booking"}]}{% endschema %}

