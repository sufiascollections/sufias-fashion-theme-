{{ 'sufias-wholesale.css' | asset_url | stylesheet_tag }}
<section class="sw" data-wholesale{% if customer %} data-customer="{{ customer.id }}"{% endif %}>
  <header class="sw-hero">
    <div class="sw-wrap sw-hero__inner">
      <div>
        <p class="sw-kicker">Sufias Fashion · Wholesale</p>
        <h1 class="sw-hero__title">Wholesale collection</h1>
        <p class="sw-hero__lead">Bulk orders for approved retailers. Choose a design, set quantities per colour and send your request — we confirm stock and delivery.</p>
      </div>
      <nav class="sw-hero__actions" aria-label="Wholesale account">
        <a class="sw-btn sw-btn--ghost-light" href="/pages/ledger">Ledger</a>
        {% if customer %}<button type="button" class="sw-btn sw-btn--ghost-light" data-wholesale-lock hidden>Lock</button>{% endif %}
      </nav>
    </div>
  </header>

  <div class="sw-gate sw-wrap" data-wholesale-gate>
    <div class="sw-card sw-gate__card">
      {% if customer %}
        <p class="sw-gate__hello">Assalam o Alaikum, {{ customer.first_name | default: customer.name | escape }}</p>
        <p class="sw-status" data-wholesale-status role="status" aria-live="polite">Checking wholesale access…</p>
        <form class="sw-form" data-wholesale-apply method="post" action="#" hidden>
          <h2 class="sw-h2">Request wholesale access</h2>
          <p class="sw-muted">Wholesale is for bulk buyers approved by Sufias Fashion.</p>
          <label class="sw-field"><span>Your name</span><input name="name" value="{{ customer.name | escape }}" maxlength="150" autocomplete="name" required></label>
          <label class="sw-field"><span>Business / shop name</span><input name="business" maxlength="200" minlength="2" autocomplete="organization" required></label>
          <label class="sw-field"><span>Phone / WhatsApp</span><input name="phone" type="tel" value="{{ customer.phone | escape }}" maxlength="40" minlength="6" autocomplete="tel" required></label>
          <button class="sw-btn sw-btn--primary sw-btn--block" type="submit">Request owner approval</button>
        </form>
        <form class="sw-form" data-wholesale-unlock method="post" action="#" hidden>
          <h2 class="sw-h2">Enter your monthly PIN</h2>
          <p class="sw-muted">Enter your PIN once — wholesale and your ledger stay open on this device for one month from today.</p>
          <label class="sw-field"><span>PIN</span><input name="pin" type="password" inputmode="numeric" pattern="[0-9]{6,12}" minlength="6" maxlength="12" autocomplete="current-password" required></label>
          <button class="sw-btn sw-btn--primary sw-btn--block" type="submit">Unlock wholesale</button>
          <a class="sw-link" href="/pages/ledger">Forgot PIN?</a>
        </form>
      {% else %}
        {%- capture sufias_login_url -%}{{ routes.storefront_login_url }}{% if routes.storefront_login_url contains '?' %}&{% else %}?{% endif %}return_url={{ request.path | url_encode }}&return_to={{ request.path | url_encode }}{%- endcapture -%}
        <h2 class="sw-h2">Log in to continue</h2>
        <p class="sw-muted">Log in to request wholesale access. Registration alone does not unlock wholesale prices.</p>
        <a class="sw-btn sw-btn--primary sw-btn--block" href="{{ sufias_login_url | escape }}">Log in / Register</a>
      {% endif %}
    </div>
  </div>

  {% if customer %}
  <div class="sw-content" data-wholesale-content hidden>
    <div class="sw-toolbar">
      <div class="sw-wrap sw-toolbar__inner">
        <label class="sw-search"><span class="sw-visually-hidden">Search designs</span><input type="search" placeholder="Search designs" data-wholesale-search autocomplete="off"></label>
        <p class="sw-toolbar__meta" data-wholesale-unlocked></p>
        <a class="sw-btn sw-btn--primary sw-toolbar__bag" href="#wholesale-bag">Bulk request <span class="sw-badge" data-wholesale-count>0</span></a>
      </div>
    </div>

    <section class="sw-section sw-section--dark" data-upcoming-section hidden>
      <div class="sw-wrap">
        <div class="sw-section__head"><div><p class="sw-kicker">The next drops</p><h2 class="sw-h2">Coming soon</h2></div></div>
        <div class="sw-grid" data-wholesale-upcoming></div>
      </div>
    </section>

    <section class="sw-section">
      <div class="sw-wrap">
        <div class="sw-section__head">
          <div><p class="sw-kicker">Available now</p><h2 class="sw-h2">Wholesale designs</h2></div>
          <p class="sw-muted">Tap a design to see full details and order by colour. Minimum <strong data-wholesale-min>2</strong> suits per design — mix colours freely.</p>
        </div>
        <div class="sw-grid" data-wholesale-products></div>
      </div>
    </section>

    <section class="sw-section sw-section--soft" id="wholesale-bag">
      <div class="sw-wrap sw-bag">
        <div>
          <p class="sw-kicker">Your order</p>
          <h2 class="sw-h2">Bulk request</h2>
          <p class="sw-muted">Stock and delivery are confirmed by Sufias Fashion after you send the request.</p>
        </div>
        <div class="sw-card sw-bag__card">
          <div data-wholesale-bag></div>
          <label class="sw-field"><span>Notes for Sufias (optional)</span><textarea data-wholesale-note maxlength="1000" rows="3" placeholder="Delivery city, packing, timing…"></textarea></label>
          <button class="sw-btn sw-btn--primary sw-btn--block" type="button" data-wholesale-submit>Send bulk request</button>
          <p class="sw-status" data-wholesale-order-status role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>

    <a class="sw-jump" href="#wholesale-bag" data-wholesale-jump hidden></a>
  </div>

  <div class="sw-modal" data-wholesale-modal hidden>
    <div class="sw-modal__backdrop" data-wholesale-close></div>
    <div class="sw-modal__sheet" role="dialog" aria-modal="true" aria-labelledby="sw-modal-title" tabindex="-1">
      <button type="button" class="sw-modal__close" data-wholesale-close aria-label="Close">&times;</button>
      <div class="sw-gallery">
        <div class="sw-gallery__track" data-wholesale-gallery></div>
        <div class="sw-gallery__thumbs" data-wholesale-thumbs></div>
      </div>
      <div class="sw-detail">
        <p class="sw-kicker" data-wholesale-detail-type></p>
        <h2 class="sw-detail__title" id="sw-modal-title" data-wholesale-detail-title></h2>
        <p class="sw-detail__price" data-wholesale-detail-price></p>
        <div class="sw-detail__colours">
          <div class="sw-detail__colours-head"><h3>Quantity by colour</h3><span class="sw-muted" data-wholesale-detail-min></span></div>
          <div data-wholesale-detail-rows></div>
        </div>
        <div class="sw-detail__total"><span data-wholesale-detail-count>0 suits</span><strong data-wholesale-detail-total></strong></div>
        <p class="sw-status" data-wholesale-detail-status role="status" aria-live="polite"></p>
        <button type="button" class="sw-btn sw-btn--primary sw-btn--block" data-wholesale-detail-done>Done</button>
        <div class="sw-detail__desc" data-wholesale-detail-desc></div>
      </div>
    </div>
  </div>
  <script src="{{ 'sufias-wholesale-secure.js' | asset_url }}" defer></script>
  {% endif %}
</section>
{% schema %}{"name":"Sufias Booking","tag":"section","class":"t4s-section sufias-booking-section","settings":[{"type":"checkbox","id":"ledger_enabled","label":"Save bookings to connected khata backend","default":true}],"presets":[{"name":"Sufias Booking"}]}{% endschema %}
