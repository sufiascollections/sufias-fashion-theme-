{{ 'sufias-wholesale.css' | asset_url | stylesheet_tag }}
<section class="sw" data-wholesale{% if customer %} data-customer="{{ customer.id }}"{% endif %}>
  {%- comment -%}
    Banner: heading on the left, a floating fan of three suit photos on the right. Photos chosen in the theme editor
    are used first; otherwise the newest wholesale designs, one per colour family (no abayas, no coming-soon).
  {%- endcomment -%}
  <header class="sw-hero sw-hero--fan">
    <div class="sw-wrap sw-hero__inner">
      <div class="sw-hero__text">
        <p class="sw-kicker">Sufias Fashion · Wholesale</p>
        <h1 class="sw-hero__title">Wholesale <span class="sw-hero__shine">embroidered</span> suits</h1>
        <p class="sw-hero__lead">Wholesale 3-piece embroidered suits for boutiques and resellers across Pakistan. Choose a design, set quantities per colour and order 10 to 24 suits per design.</p>
        <nav class="sw-hero__actions" aria-label="Wholesale account">
          <a class="sw-btn sw-btn--ghost-light" href="/pages/ledger">Ledger</a>
          <a class="sw-btn sw-btn--ghost-light" href="/pages/sell">Sell with us</a>
          {% if customer %}<button type="button" class="sw-btn sw-btn--ghost-light" data-wholesale-lock hidden>Lock</button>{% endif %}
        </nav>
      </div>
      <div class="sw-hero__fan" aria-hidden="true">
        <i class="sw-hero__glow"></i>
        {%- assign shown = 0 -%}
        {%- for n in (1..3) -%}
          {%- assign key = 'hero_image_' | append: n -%}
          {%- assign img = section.settings[key] -%}
          {%- if img != blank -%}
            {%- assign shown = shown | plus: 1 -%}
            <span class="sw-hero__card">{{ img | image_url: width: 560 | image_tag: widths: '280, 420, 560', sizes: '(min-width: 990px) 230px, 34vw', loading: 'eager', alt: '' }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- if shown == 0 -%}
          {%- assign used_fams = '' -%}
          {%- paginate collections.all.products by 250 -%}
            {%- assign newest = collections.all.products | sort: 'created_at' | reverse -%}
            {%- for p in newest -%}
              {%- if shown >= 3 -%}{%- break -%}{%- endif -%}
              {%- unless p.tags contains 'booking' -%}{%- continue -%}{%- endunless -%}
              {%- if p.tags contains 'preview' or p.featured_image == blank or p.type == 'Abaya' or p.tags contains 'abaya' or p.tags contains 'Abaya' -%}{%- continue -%}{%- endif -%}
              {%- liquid
                assign c = p.variants.first.title | downcase
                assign fam = 'other'
                if c contains 'blue' or c contains 'teal' or c contains 'navy' or c contains 'zinc'
                  assign fam = 'blue'
                elsif c contains 'purple' or c contains 'plum' or c contains 'mauve' or c contains 'lilac'
                  assign fam = 'purple'
                elsif c contains 'pink' or c contains 'magenta'
                  assign fam = 'pink'
                elsif c contains 'green' or c contains 'olive' or c contains 'emerald'
                  assign fam = 'green'
                elsif c contains 'mustard' or c contains 'yellow' or c contains 'gold' or c contains 'orange'
                  assign fam = 'yellow'
                elsif c contains 'beige' or c contains 'brown' or c contains 'cream' or c contains 'champagne' or c contains 'taupe'
                  assign fam = 'brown'
                elsif c contains 'black' or c contains 'grey' or c contains 'charcoal'
                  assign fam = 'black'
                elsif c contains 'red' or c contains 'maroon' or c contains 'burgundy'
                  assign fam = 'red'
                endif
                assign fam_key = '|' | append: fam | append: '|'
              -%}
              {%- if fam != 'other' and used_fams contains fam_key -%}{%- continue -%}{%- endif -%}
              {%- assign used_fams = used_fams | append: fam_key -%}
              {%- assign shown = shown | plus: 1 -%}
              <span class="sw-hero__card">{{ p.featured_image | image_url: width: 560 | image_tag: widths: '280, 420, 560', sizes: '(min-width: 990px) 230px, 34vw', loading: 'eager', alt: '' }}</span>
            {%- endfor -%}
          {%- endpaginate -%}
        {%- endif -%}
      </div>
    </div>
  </header>
  <style>
    .sw-hero--fan{position:relative;overflow:hidden;background:radial-gradient(90% 140% at 85% 20%,#3d3022 0%,#1d1c1a 58%,#151412 100%)}
    .sw-hero--fan::before{content:"";position:absolute;inset:0;background-image:radial-gradient(rgb(201 169 110 / 14%) 1px,transparent 1px);background-size:22px 22px;mask-image:linear-gradient(90deg,transparent 35%,#000 100%);-webkit-mask-image:linear-gradient(90deg,transparent 35%,#000 100%);pointer-events:none}
    .sw-hero--fan .sw-hero__inner{position:relative;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);align-items:center;gap:clamp(24px,4vw,56px)}
    .sw-hero--fan .sw-hero__actions{margin-top:22px}
    .sw-hero__shine{background:linear-gradient(100deg,#fff 0%,#fff 40%,#e7cf99 50%,#fff 60%,#fff 100%);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:swShine 6s ease-in-out infinite}
    .sw-hero__fan{position:relative;display:flex;justify-content:center;align-items:center;min-height:330px;padding:10px 0}
    .sw-hero__glow{position:absolute;left:50%;top:50%;width:78%;aspect-ratio:1;transform:translate(-50%,-50%);border-radius:50%;background:radial-gradient(circle,rgb(201 169 110 / 38%) 0%,rgb(201 169 110 / 0) 65%);filter:blur(10px);animation:swGlow 5s ease-in-out infinite}
    .sw-hero__card{position:relative;flex:0 0 auto;width:clamp(150px,15vw,205px);aspect-ratio:4/5;border-radius:16px;overflow:hidden;border:1px solid rgb(231 207 153 / 55%);box-shadow:0 22px 46px rgb(0 0 0 / 50%),0 0 0 4px rgb(255 255 255 / 4%);background:#2b2925;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
    .sw-hero__card img{width:100%;height:100%;object-fit:cover;display:block}
    .sw-hero__card::after{content:"";position:absolute;inset:0;background:linear-gradient(115deg,transparent 35%,rgb(255 255 255 / 28%) 50%,transparent 65%);transform:translateX(-120%);animation:swSweep 5.5s ease-in-out infinite}
    .sw-hero__card:nth-of-type(1){--r:-7deg;--x:34px;--y:8px;z-index:1;animation:swFloat 6s ease-in-out infinite}
    .sw-hero__card:nth-of-type(2){--r:0deg;--x:0px;--y:-16px;z-index:3;width:clamp(170px,17vw,232px);animation:swFloat 6s ease-in-out -2s infinite}
    .sw-hero__card:nth-of-type(3){--r:7deg;--x:-34px;--y:8px;z-index:2;animation:swFloat 6s ease-in-out -4s infinite}
    .sw-hero__card:nth-of-type(2)::after{animation-delay:1.2s}
    .sw-hero__card:nth-of-type(3)::after{animation-delay:2.4s}
    @media (hover:hover){
      .sw-hero__fan:hover .sw-hero__card:nth-of-type(1){--x:6px;--r:-10deg}
      .sw-hero__fan:hover .sw-hero__card:nth-of-type(3){--x:-6px;--r:10deg}
      .sw-hero__fan:hover .sw-hero__card:nth-of-type(2){--y:-24px}
    }
    @keyframes swFloat{0%,100%{transform:translate(var(--x),var(--y)) rotate(var(--r))}50%{transform:translate(var(--x),calc(var(--y) - 10px)) rotate(var(--r))}}
    @keyframes swSweep{0%,55%{transform:translateX(-120%)}80%,100%{transform:translateX(120%)}}
    @keyframes swGlow{0%,100%{opacity:.75}50%{opacity:1}}
    @keyframes swShine{0%,100%{background-position:100% 0}50%{background-position:0 0}}
    @media (max-width:749px){
      .sw-hero--fan .sw-hero__inner{grid-template-columns:1fr}
      .sw-hero__fan{order:-1;min-height:0;padding:8px 0 10px}
      .sw-hero__card{width:31%;max-width:150px}
      .sw-hero__card:nth-of-type(2){width:35%;max-width:168px}
      .sw-hero__card:nth-of-type(1){--x:14px}
      .sw-hero__card:nth-of-type(3){--x:-14px}
        .sw-hero--fan::before{mask-image:none;-webkit-mask-image:none;opacity:.5}
    }
  </style>

  {%- render 'sufias-coming-soon' -%}

  <div class="sw-gate sw-wrap" data-wholesale-gate>
    <div class="sw-card sw-gate__card">
      {% if customer %}
        <p class="sw-gate__hello">Assalam o Alaikum, {{ customer.first_name | default: customer.name | escape }}</p>
        <p class="sw-status" data-wholesale-status role="status" aria-live="polite">Checking wholesale access…</p>
        <form class="sw-form" data-wholesale-apply method="post" action="#" hidden>
          <h2 class="sw-h2">Request wholesale access</h2>
          <p class="sw-muted">Wholesale is for bulk buyers approved by Sufias Fashion.</p>
          <label class="sw-field"><span>Your name</span><input name="name" value="{{ customer.name | escape }}" maxlength="150" autocomplete="name" required></label>
          <label class="sw-field"><span>Business / shop name</span><input name="business" maxlength="200" minlength="2" autocomplete="organization" required></label>
          <label class="sw-field"><span>Phone / WhatsApp</span><input name="phone" type="tel" value="{{ customer.phone | escape }}" maxlength="40" minlength="6" autocomplete="tel" required></label>
          <button class="sw-btn sw-btn--primary sw-btn--block" type="submit">Request owner approval</button>
        </form>
        <form class="sw-form" data-wholesale-unlock method="post" action="#" hidden>
          <h2 class="sw-h2">Enter your monthly PIN</h2>
          <p class="sw-muted">Enter your PIN once — wholesale and your ledger stay open on this device for one month from today.</p>
          <label class="sw-field"><span>PIN</span><input name="pin" type="password" inputmode="numeric" pattern="[0-9]{6,12}" minlength="6" maxlength="12" autocomplete="current-password" required></label>
          <button class="sw-btn sw-btn--primary sw-btn--block" type="submit">Unlock wholesale</button>
          <a class="sw-link" href="/pages/ledger">Forgot PIN?</a>
        </form>
      {% else %}
        {%- capture sufias_login_url -%}{{ routes.storefront_login_url }}{% if routes.storefront_login_url contains '?' %}&{% else %}?{% endif %}return_url={{ request.path | url_encode }}&return_to={{ request.path | url_encode }}{%- endcapture -%}
        <h2 class="sw-h2">Log in to continue</h2>
        <p class="sw-muted">Log in to request wholesale access. Registration alone does not unlock wholesale prices.</p>
        <a class="sw-btn sw-btn--primary sw-btn--block" href="{{ sufias_login_url | escape }}">Log in / Register</a>
      {% endif %}
    </div>
  </div>

  {% if customer %}
  <div class="sw-content" data-wholesale-content hidden>
    <div class="sw-toolbar">
      <div class="sw-wrap sw-toolbar__inner">
        <label class="sw-search"><span class="sw-visually-hidden">Search designs</span><input type="search" placeholder="Search designs" data-wholesale-search autocomplete="off"></label>
        <p class="sw-toolbar__meta" data-wholesale-unlocked></p>
        <a class="sw-btn sw-btn--primary sw-toolbar__bag" href="#wholesale-bag">Your order <span class="sw-badge" data-wholesale-count>0</span></a>
      </div>
    </div>

    <section class="sw-section sw-section--dark" data-upcoming-section hidden>
      <div class="sw-wrap">
        <div class="sw-section__head"><div><p class="sw-kicker">The next drops</p><h2 class="sw-h2">Coming soon</h2></div></div>
        <div class="sw-grid" data-wholesale-upcoming></div>
      </div>
    </section>

    <section class="sw-section">
      <div class="sw-wrap">
        <div class="sw-section__head">
          <div><p class="sw-kicker">Available now</p><h2 class="sw-h2">Wholesale designs</h2></div>
          <p class="sw-muted">Tap a design to see full details and order by colour. Minimum <strong data-wholesale-min>10</strong> suits per design — mix colours freely.</p>
        </div>
        <div class="sw-grid" data-wholesale-products></div>
      </div>
    </section>

    <section class="sw-section sw-section--soft" id="wholesale-bag">
      <div class="sw-wrap sw-bag">
        <div>
          <p class="sw-kicker">Your order</p>
          <h2 class="sw-h2">Bulk order</h2>
          <p class="sw-muted">Place your order, then add your shipping address and pay by bank transfer at checkout. Sufias Fashion dispatches once your payment is received.</p>
        </div>
        <div class="sw-card sw-bag__card">
          <div data-wholesale-bag></div>
          <label class="sw-field"><span>Notes for Sufias (optional)</span><textarea data-wholesale-note maxlength="1000" rows="3" placeholder="Delivery city, packing, timing…"></textarea></label>
          <button class="sw-btn sw-btn--primary sw-btn--block" type="button" data-wholesale-submit>Place order &amp; pay</button>
          <p class="sw-status" data-wholesale-order-status role="status" aria-live="polite"></p>
        </div>
      </div>
    </section>

    <a class="sw-jump" href="#wholesale-bag" data-wholesale-jump hidden></a>
  </div>

  <div class="sw-modal" data-wholesale-modal hidden>
    <div class="sw-modal__backdrop" data-wholesale-close></div>
    <div class="sw-modal__sheet" role="dialog" aria-modal="true" aria-labelledby="sw-modal-title" tabindex="-1">
      <button type="button" class="sw-modal__close" data-wholesale-close aria-label="Close">&times;</button>
      <div class="sw-gallery">
        <div class="sw-gallery__track" data-wholesale-gallery></div>
        <div class="sw-gallery__thumbs" data-wholesale-thumbs></div>
      </div>
      <div class="sw-detail">
        <p class="sw-kicker" data-wholesale-detail-type></p>
        <h2 class="sw-detail__title" id="sw-modal-title" data-wholesale-detail-title></h2>
        <p class="sw-detail__price" data-wholesale-detail-price></p>
        <div class="sw-detail__colours">
          <div class="sw-detail__colours-head"><h3>Quantity by colour</h3><span class="sw-muted" data-wholesale-detail-min></span></div>
          <div data-wholesale-detail-rows></div>
        </div>
        <div class="sw-detail__total"><span data-wholesale-detail-count>0 suits</span><strong data-wholesale-detail-total></strong></div>
        <p class="sw-status" data-wholesale-detail-status role="status" aria-live="polite"></p>
        <button type="button" class="sw-btn sw-btn--primary sw-btn--block" data-wholesale-detail-done>Done</button>
        <div class="sw-detail__desc" data-wholesale-detail-desc></div>
      </div>
    </div>
  </div>
  <script src="{{ 'sufias-wholesale-secure.js' | asset_url }}" defer></script>
  {% endif %}
</section>
{% schema %}{"name":"Sufias Booking","tag":"section","class":"t4s-section sufias-booking-section","settings":[{"type":"checkbox","id":"ledger_enabled","label":"Save bookings to connected khata backend","default":true},{"type":"header","content":"Banner photos"},{"type":"paragraph","content":"Leave empty to show the newest wholesale designs, one per colour."},{"type":"image_picker","id":"hero_image_1","label":"Photo 1 (left)"},{"type":"image_picker","id":"hero_image_2","label":"Photo 2 (centre)"},{"type":"image_picker","id":"hero_image_3","label":"Photo 3 (right)"}],"presets":[{"name":"Sufias Booking"}]}{% endschema %}
