{%- comment -%} v3
  Sufias Wholesale Marketplace homepage: hero, trust tiles, categories, new wholesale designs
  (real products, "Sold by" from the product vendor), how it works, sellers (from shop vendors),
  sell-with-us banner. Rules: minimum 12 suits per order (any designs mixed), 10% commission, free PostEx delivery,
  advance or COD, 3-day returns. Wholesale prices open for approved buyers on /pages/booking.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign shop_coll = s.collection | default: collections['new-arrivals']
  assign min_suits = s.min_suits | default: 12
  assign hero_img_1 = s.hero_image_1
  assign hero_img_2 = s.hero_image_2
  if hero_img_1 == blank
    assign hero_img_1 = shop_coll.products[0].featured_media.preview_image
  endif
  if hero_img_2 == blank
    assign hero_img_2 = shop_coll.products[1].featured_media.preview_image
  endif
  assign col_img_3 = shop_coll.products[2].featured_media.preview_image
  assign col_img_4 = shop_coll.products[3].featured_media.preview_image
-%}
{%- assign body_bold = s.body_font | font_modify: 'weight', 'bold' -%}
{{ 'sufias-home.css' | asset_url | stylesheet_tag }}
<style>
  {{ s.heading_font | font_face: font_display: 'swap' }}
  {{ s.body_font | font_face: font_display: 'swap' }}
  {{ body_bold | font_face: font_display: 'swap' }}
  #swh-{{ section.id }}{--swh-head:{{ s.heading_font.family }},{{ s.heading_font.fallback_families }};--swh-body:{{ s.body_font.family }},{{ s.body_font.fallback_families }}}
</style>

<div class="swh" id="swh-{{ section.id }}">
  {%- assign shop_link = s.shop_url | default: '/pages/booking' -%}
  {%- assign sell_link = s.sell_url | default: '/pages/sell' -%}
  {%- assign base_price = settings.sufias_base_wholesale_price | default: 3500 -%}

  {%- comment -%} 1. Banner made by the owner (assets/sufias-hero-banner*.jpg). The whole banner, incl. the drawn button, links to wholesale. {%- endcomment -%}
  <section class="swh-banner">
    <h1 class="swh-vh">Wholesale embroidered three-piece suits in Pakistan, Sufias wholesale marketplace</h1>
    <a href="{{ shop_link }}" class="swh-banner__link" aria-label="Shop Wholesale: embroidered three-piece suits">
      <picture>
        <source media="(max-width: 749px)" srcset="{{ 'sufias-hero-banner-mobile.jpg' | asset_url }}" width="1065" height="724">
        <img src="{{ 'sufias-hero-banner.jpg' | asset_url }}" width="2172" height="724" alt="Wholesale collection: embroidered three-piece suits" fetchpriority="high" loading="eager">
      </picture>
      <span class="swh-banner__btn" aria-hidden="true"></span>
    </a>
  </section>

  {%- render 'sufias-promo-banner', place: 'home' -%}

  {%- comment -%} 2. Trust numbers {%- endcomment -%}
  <section class="swh-stats" aria-label="Wholesale terms">
    <div class="swh-stats__in">
      <div><b>{{ min_suits }}</b><span>suits minimum per order, any designs</span></div>
      <div><b><small>from</small> Rs {{ base_price | times: 100 | money_without_currency | remove: '.00' }}</b><span>wholesale price per suit</span></div>
      <div><b>Free</b><span>PostEx delivery, all Pakistan</span></div>
      <div><b>COD</b><span>or advance payment</span></div>
      <div><b>3 days</b><span>easy return window</span></div>
    </div>
  </section>

  {%- comment -%} 3. Search + categories {%- endcomment -%}
  <section class="swh-wrap swh-sec swh-find">
    <div class="swh-find__head">
      <div>
        <p class="swh-kick">SHOP BY CATEGORY</p>
        <h2 class="swh-h2 swh-h2--tight">What are you buying today?</h2>
      </div>
      <form class="swh-search" action="{{ routes.search_url }}" role="search"><input type="search" name="q" placeholder="Search suit, colour or design no." aria-label="Search designs"><button type="submit">Search</button></form>
    </div>
    {%- if section.blocks.size > 0 -%}
    <div class="swh-catrow">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        {%- assign c_count = 0 -%}
        {%- for cp in c.products limit: 250 -%}{%- if cp.available and cp.tags contains 'booking' -%}{%- if settings.sufias_hide_abayas -%}{%- if cp.type == 'Abaya' or cp.tags contains 'abaya' or cp.tags contains 'Abaya' -%}{%- continue -%}{%- endif -%}{%- endif -%}{%- assign c_count = c_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- if c_count == 0 -%}{%- continue -%}{%- endif -%}
        {%- assign cimg = block.settings.image | default: c.featured_image | default: c.products[0].featured_media.preview_image -%}
        <a class="swh-catc" href="{{ c.url | default: '/collections/all' }}" {{ block.shopify_attributes }}>
          <span class="swh-catc__img">{%- if cimg != blank -%}{{ cimg | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 750px) 280px, 44vw', alt: '' }}{%- endif -%}</span>
          <span class="swh-catc__t">{{ block.settings.title | default: c.title | escape }}<small>{{ c_count }} design{% if c_count != 1 %}s{% endif %}</small></span>
        </a>
      {%- endfor -%}
    </div>
    {%- endif -%}
  </section>

  {%- comment -%} 4. New drop with prices {%- endcomment -%}
  <section class="hsD swh-mt"><div class="hsD__in">
    <p class="hs-eb">NEW WHOLESALE DROP</p>
    <h2 class="hs-h">Fresh winter designs, ready to ship</h2>
    <p class="hs-p">Just added this week, each with its wholesale rate.</p>
    <div class="hs-btns"><a class="hs-btn hs-gold" href="{{ shop_link }}">See all wholesale designs</a></div>
    <div class="hsD__row">
      {%- assign nd_n = 0 -%}
      {%- for p in shop_coll.products limit: 60 -%}
      {%- unless p.available and p.tags contains 'booking' -%}{%- continue -%}{%- endunless -%}{%- if settings.sufias_hide_abayas -%}{%- if p.type == 'Abaya' or p.tags contains 'abaya' or p.tags contains 'Abaya' -%}{%- continue -%}{%- endif -%}{%- endif -%}
      {%- if nd_n >= 4 -%}{%- break -%}{%- endif -%}{%- assign nd_n = nd_n | plus: 1 -%}
      {%- assign nd_code = p.title | split: '– ' | last | strip -%}
      {%- assign nd_name = p.title | split: ' – ' | first | remove: 'Embroidered ' | remove: ' 3-Piece Suit' | strip -%}
      <a class="hsD__card" href="{{ p.url }}"><div data-sf-handle="{{ p.handle }}">{%- if p.featured_media -%}{{ p.featured_media.preview_image | image_url: width: 500 | image_tag: alt: p.title, loading: 'lazy', widths: '300,400,500', sizes: '(min-width: 750px) 280px, 62vw' }}{%- endif -%}<span class="hsD__tag">NEW</span></div><p><b>{% render 'sufias-wholesale-price', product: p %}</b>{% if nd_code.size <= 8 and nd_code != p.title %}<span class="hsD__code">Design {{ nd_code | escape }}</span>{{ nd_name | escape }}{% else %}{{ p.title | truncate: 42 | escape }}{% endif %}</p></a>
      {%- endfor -%}
    </div>
  </div></section>

  {%- comment -%} 5. Bulk order calculator {%- endcomment -%}
  <section class="swh-wrap swh-sec">
    <div class="swh-calc" data-swh-calc data-price="{{ base_price }}" data-min="{{ min_suits }}">
      <div class="swh-calc__text">
        <p class="swh-kick swh-kick--gold">BULK ORDER PLANNER</p>
        <h2 class="swh-h2 swh-h2--tight">Plan your bulk order</h2>
        <p>Move the slider to see what your order will cost before you place it.</p>
      </div>
      <div class="swh-calc__box">
        <label class="swh-calc__lab" for="swh-qty-{{ section.id }}">Number of suits <output data-calc-qty>{{ min_suits | times: 2 }}</output></label>
        <input id="swh-qty-{{ section.id }}" type="range" min="{{ min_suits }}" max="{{ min_suits | times: 20 }}" step="1" value="{{ min_suits | times: 2 }}" data-calc-range>
        <div class="swh-calc__rows">
          <div><span>Designs</span><b>Mix any designs</b></div>
          <div><span>Price per suit, from</span><b>Rs {{ base_price | times: 100 | money_without_currency | remove: '.00' }}</b></div>
          <div><span>PostEx delivery</span><b>Free</b></div>
          <div class="swh-calc__total"><span>Estimated total</span><b data-calc-total></b></div>
        </div>
        <a class="swh-btn swh-btn--gold swh-calc__btn" href="{{ shop_link }}">Start your wholesale order</a>
        <p class="swh-calc__note">Price shown is the standard wholesale rate. Some designs have their own rate.</p>
      </div>
    </div>
  </section>

  <section class="swh-wrap swh-sec" id="shop">
    <div class="swh-head">
      <h2 class="swh-h2">{{ s.products_title }}</h2>
      {%- if shop_coll != blank -%}<a class="swh-more" href="{{ shop_coll.url }}">View all suits</a>{%- endif -%}
    </div>
    <div class="swh-grid">
      {%- assign pg_n = 0 -%}
      {%- for p in shop_coll.products limit: 100 -%}
        {%- unless p.available and p.tags contains 'booking' -%}{%- continue -%}{%- endunless -%}{%- if settings.sufias_hide_abayas -%}{%- if p.type == 'Abaya' or p.tags contains 'abaya' or p.tags contains 'Abaya' -%}{%- continue -%}{%- endif -%}{%- endif -%}
        {%- assign pg_n = pg_n | plus: 1 -%}
        {%- if pg_n <= 4 -%}{%- continue -%}{%- endif -%}
        {%- assign pg_max = s.products_limit | plus: 4 -%}
        {%- if pg_n > pg_max -%}{%- break -%}{%- endif -%}
        {%- liquid
          assign is_sufias = false
          assign v = p.vendor | downcase
          if v contains 'sufias'
            assign is_sufias = true
          endif
          assign fabric = p.type
          if fabric contains 'Suit'
            assign fabric = 'Suit'
          endif
          if p.tags contains 'winter-cotton'
            assign fabric = 'Winter cotton'
          elsif p.type == 'Abaya' or p.tags contains 'Abaya'
            assign fabric = 'Abaya'
          elsif p.tags contains 'lawn'
            assign fabric = 'Lawn'
          elsif p.tags contains 'chiffon'
            assign fabric = 'Chiffon'
          endif
          if p.tags contains '3-piece-suit' or p.tags contains '3-piece dresses'
            if fabric == 'Suit'
              assign fabric = '3-piece suit'
            else
              assign fabric = fabric | append: ' · 3-piece'
            endif
          endif
          assign t_low = p.title | downcase
          if t_low contains 'winter cotton' or p.tags contains 'winter-cotton'
            assign fabric = 'Winter cotton · 3-piece'
          elsif fabric == 'Suit' and t_low contains '3-piece'
            assign fabric = '3-piece suit'
          endif
          assign pimg = p.featured_media.preview_image
        -%}
        <article class="swh-card swh-pc">
          <a class="swh-pc__img" href="{{ p.url }}" data-sf-handle="{{ p.handle }}">
            {%- if pimg != blank -%}{{ pimg | image_url: width: 600 | image_tag: loading: 'lazy', widths: '240,360,480,600', sizes: '(min-width: 990px) 280px, 46vw', alt: p.title }}{%- endif -%}
            {%- unless is_sufias -%}<span class="swh-badge">Seller</span>{%- endunless -%}
          </a>
          <div class="swh-pc__body">
            <div class="swh-pc__seller">Sold by {% if is_sufias %}Sufias Fashion{% else %}{{ p.vendor | escape }}{% endif %}</div>
            <h3 class="swh-pc__t"><a href="{{ p.url }}">{{ p.title | escape }}</a></h3>
            {%- if fabric != blank -%}<div class="swh-pc__m">{{ fabric | escape }}</div>{%- endif -%}
            <div class="swh-pc__price">{% render 'sufias-wholesale-price', product: p %}</div>
            <div class="swh-pc__m">Mix with any design · {% if p.available %}In stock{% else %}Coming soon{% endif %}</div>
            <a class="swh-btn swh-btn--green swh-pc__btn" href="/pages/booking?design={{ p.id }}">Order wholesale</a>
          </div>
        </article>
      {%- else -%}
        <p class="swh-empty">New wholesale designs are coming soon.</p>
      {%- endfor -%}
    </div>
  </section>


  {%- comment -%} 7. Why buy here: photo collage {%- endcomment -%}
  <section class="hsB swh-mt"><div class="hsB__in">
    <div>
      <p class="hs-eb">FOR BOUTIQUES &amp; ONLINE SELLERS</p>
      <h2 class="hs-h">Why shop owners buy from Sufias</h2>
      <ul class="swh-ticks">
        <li><b>Factory-direct</b> from Sufias and checked sellers in Lahore</li>
        <li><b>Quality checked</b> before any design goes live</li>
        <li><b>New designs every week</b> in winter cotton, lawn and chiffon</li>
        <li><b>Account statement</b> online: every order and payment in one place</li>
        <li><b>WhatsApp support</b> from a real person in Lahore</li>
      </ul>
      <div class="hs-btns"><a class="hs-btn hs-green" href="{{ shop_link }}">Shop Wholesale</a><a class="hs-btn hs-line hs-line--g" href="{{ sell_link }}">Sell on Sufias</a></div>
    </div>
    <div class="hsB__pics">
      <div>{%- if hero_img_2 != blank -%}{{ hero_img_2 | image_url: width: 900 | image_tag: alt: 'Sufias embroidered 3-piece suit, wholesale', loading: 'lazy', widths: '450,700,900', sizes: '(min-width: 750px) 330px, 55vw' }}{%- endif -%}</div>
      <div>{%- if col_img_3 != blank -%}{{ col_img_3 | image_url: width: 600 | image_tag: alt: 'Sufias embroidered 3-piece suit, wholesale', loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 750px) 250px, 42vw' }}{%- endif -%}</div>
      <div>{%- if col_img_4 != blank -%}{{ col_img_4 | image_url: width: 600 | image_tag: alt: 'Sufias embroidered 3-piece suit, wholesale', loading: 'lazy', widths: '300,450,600', sizes: '(min-width: 750px) 250px, 42vw' }}{%- endif -%}</div>
    </div>
  </div></section>

  {%- comment -%} 8. How it works: timeline {%- endcomment -%}
  <section class="swh-wrap swh-sec" id="how">
    <p class="swh-kick">HOW WHOLESALE BUYING WORKS</p>
    <h2 class="swh-h2">From order to your shop in 4 steps</h2>
    <ol class="swh-time">
      <li><span>1</span><h3>Browse designs</h3><p>Every design and its wholesale price is open to everyone.</p></li>
      <li><span>2</span><h3>Pick colours</h3><p>Set a quantity for each colour you want.</p></li>
      <li><span>3</span><h3>Place your order</h3><p>Log in once and choose how to pay.</p></li>
      <li><span>4</span><h3>Receive with PostEx</h3><p>You get the tracking number on WhatsApp.</p></li>
    </ol>
  </section>

  {%- liquid
    assign other_sellers = 0
    for vendor in shop.vendors
      assign vd = vendor | downcase
      unless vd contains 'sufias'
        assign other_sellers = other_sellers | plus: 1
      endunless
    endfor
  -%}
  {%- comment -%} Shown once at least one outside seller is live; until then the "Sell on Sufias" banner below covers it. {%- endcomment -%}
  {%- if other_sellers == 0 -%}<span id="sellers"></span>{%- else -%}
  <section class="swh-wrap swh-sec" id="sellers">
    <h2 class="swh-h2">Sellers on Sufias</h2>
    <div class="swh-sellers">
      <div class="swh-seller swh-seller--main"><div class="swh-av">S</div><div><div class="swh-seller__n">Sufias Fashion</div><div class="swh-seller__d">Lahore · Official store</div></div></div>
      {%- for vendor in shop.vendors -%}
        {%- assign vd = vendor | downcase -%}
        {%- unless vd contains 'sufias' -%}
        <a class="swh-seller" href="{{ vendor | url_for_vendor }}"><div class="swh-av swh-av--gold">{{ vendor | strip | slice: 0 | upcase }}</div><div><div class="swh-seller__n">{{ vendor | escape }}</div><div class="swh-seller__d">Verified seller</div></div></a>
        {%- endunless -%}
      {%- endfor -%}
      <a class="swh-seller swh-seller--join" href="{{ s.sell_url | default: '/pages/sell' }}"><div class="swh-av swh-av--gold">+</div><div><div class="swh-seller__n">Your brand here</div><div class="swh-seller__d">Join as a seller</div></div></a>
    </div>
  </section>
  {%- endif -%}


  {%- comment -%} 10. Sell with us {%- endcomment -%}
  <section class="swh-wrap swh-sec" id="sell">
    <div class="swh-sellb">
      <div class="swh-sellb__text">
        <p class="swh-kick swh-kick--gold">FOR BRANDS &amp; MANUFACTURERS</p>
        <h2 class="swh-h2 swh-h2--tight">Sell your suits on Sufias</h2>
        <p>Reach boutiques and online sellers across Pakistan. We handle orders, PostEx shipping and payment collection.</p>
        <a class="swh-btn swh-btn--gold" href="{{ sell_link }}">Register as a Seller</a>
      </div>
      <div class="swh-sellb__nums">
        <div><b>10%</b><span>commission only when you sell</span></div>
        <div><b>0</b><span>listing or monthly fee</span></div>
        <div><b>Delivery + 3 days</b><span>then your payout is released</span></div>
      </div>
    </div>
  </section>
</div>


<script>
(function(){
  var box=document.querySelector('#swh-{{ section.id }} [data-swh-calc]'); if(!box) return;
  var r=box.querySelector('[data-calc-range]'), price=+box.dataset.price||0, min=+box.dataset.min||12;
  function upd(){ var q=+r.value; box.querySelector('[data-calc-qty]').textContent=q+' suits';
    box.querySelector('[data-calc-total]').textContent='Rs '+(q*price).toLocaleString('en-PK');
    r.style.setProperty('--p',((q-r.min)/(r.max-r.min)*100)+'%'); }
  r.addEventListener('input',upd); upd();
})();
</script>

{% schema %}
{
  "name": "Sufias wholesale home",
  "class": "sufias-wholesale-home-section",
  "settings": [
    { "type": "checkbox", "id": "show_topbar", "label": "Show green wholesale bar", "default": true },
    { "type": "number", "id": "min_suits", "label": "Minimum suits per order", "default": 12 },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "playfair_display_n6" },
    { "type": "font_picker", "id": "body_font", "label": "Text font", "default": "inter_n4" },
    { "type": "text", "id": "hero_title", "label": "Hero heading", "default": "Pakistan's Wholesale Suits Marketplace" },
    { "type": "textarea", "id": "hero_text", "label": "Hero text", "default": "Embroidered 3-piece suits and winter cotton from Sufias and trusted sellers, all at wholesale prices. One place, many sellers." },
    { "type": "image_picker", "id": "hero_image_1", "label": "Hero photo 1 (empty = first product photo)" },
    { "type": "image_picker", "id": "hero_image_2", "label": "Hero photo 2 (empty = second product photo)" },
    { "type": "url", "id": "shop_url", "label": "Shop Wholesale link" },
    { "type": "url", "id": "sell_url", "label": "Seller link" },
    { "type": "text", "id": "products_title", "label": "Products heading", "default": "More wholesale designs" },
    { "type": "collection", "id": "collection", "label": "Products from collection" },
    { "type": "range", "id": "products_limit", "label": "Number of products", "min": 2, "max": 16, "step": 2, "default": 8 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Name" },
        { "type": "image_picker", "id": "image", "label": "Photo (empty = collection photo)" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{ "name": "Sufias wholesale home" }]
}
{% endschema %}
