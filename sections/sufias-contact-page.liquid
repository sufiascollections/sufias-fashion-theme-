{%- comment -%}
  Contact page for the Sufias wholesale marketplace (template page.contact). Navy / ivory / gold.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign wa = s.whatsapp | remove: ' ' | remove: '+' | remove: '-'
  assign tel = s.whatsapp | remove: ' ' | remove: '-'
-%}
<div class="sct">
  <section class="sct-hero">
    <div class="sct-in">
      <p class="sct-kick">Contact Sufias</p>
      <h1 class="sct-h1">{{ s.title }}</h1>
      <p class="sct-lead">{{ s.lead }}</p>
    </div>
  </section>

  <section class="sct-in sct-cards" aria-label="Ways to reach us">
    <a class="sct-card sct-card--main" href="https://wa.me/{{ wa }}" target="_blank" rel="noopener">
      <span class="sct-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3Z"/></svg></span>
      <b>WhatsApp</b><span>{{ s.whatsapp }}</span><em>Fastest reply</em>
    </a>
    <a class="sct-card" href="tel:{{ tel }}">
      <span class="sct-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2Z"/></svg></span>
      <b>Call us</b><span>{{ s.whatsapp }}</span><em>{{ s.hours }}</em>
    </a>
    <a class="sct-card" href="mailto:{{ s.email }}">
      <span class="sct-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></span>
      <b>Email</b><span class="sct-break">{{ s.email }}</span><em>We reply within working hours</em>
    </a>
    <a class="sct-card" href="{{ s.maps_link }}" target="_blank" rel="noopener">
      <span class="sct-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-6.1 7-12a7 7 0 0 0-14 0c0 5.9 7 12 7 12Z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
      <b>Visit us</b><span>{{ s.address }}</span><em>Open in Google Maps</em>
    </a>
  </section>

  <section class="sct-in sct-help">
    <div class="sct-box">
      <p class="sct-kick sct-kick--dark">Buying wholesale</p>
      <h2 class="sct-h2">Help for shop owners</h2>
      <ul>
        <li>Prices, colours and stock of a design</li>
        <li>Placing an order of 12 suits or more</li>
        <li>Advance payment or cash on delivery</li>
        <li>PostEx tracking and delivery time</li>
        <li>Returns within 3 days of delivery</li>
      </ul>
      <a class="sct-link" href="https://wa.me/{{ wa }}?text={{ 'Hello Sufias, I have a question about a wholesale order.' | url_encode }}" target="_blank" rel="noopener">Ask about an order on WhatsApp</a>
    </div>
    <div class="sct-box">
      <p class="sct-kick sct-kick--dark">Selling on Sufias</p>
      <h2 class="sct-h2">Help for brands and makers</h2>
      <ul>
        <li>Opening a seller account and approval</li>
        <li>Adding designs, photos and colours</li>
        <li>The 10% commission and your earnings</li>
        <li>When and how payouts are made</li>
      </ul>
      <a class="sct-link" href="https://wa.me/{{ wa }}?text={{ 'Hello Sufias, I want to sell my suits on Sufias.' | url_encode }}" target="_blank" rel="noopener">Ask about selling on WhatsApp</a>
    </div>
  </section>

  <section class="sct-in sct-formwrap" id="contact-form">
    <div class="sct-formcard">
      <h2 class="sct-h2">Send us a message</h2>
      <p class="sct-sub">We reply within working hours.</p>
      {%- form 'contact', class: 'sct-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="sct-ok" role="status">Thank you. Your message has been sent and we will get back to you soon.</p>
        {%- elsif form.errors -%}
          <div class="sct-err" role="alert">{{ form.errors | default_errors }}</div>
        {%- endif -%}
        <div class="sct-grid">
          <label class="sct-f"><span>Your name</span><input type="text" name="contact[name]" autocomplete="name" required value="{{ form.name }}"></label>
          <label class="sct-f"><span>Phone / WhatsApp</span><input type="tel" name="contact[phone]" autocomplete="tel" inputmode="tel" value="{{ form.phone }}"></label>
          <label class="sct-f"><span>Email</span><input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></label>
          <label class="sct-f"><span>I am a</span>
            <select name="contact[I am a]">
              <option>Shop owner / buyer</option>
              <option>Brand / seller</option>
              <option>Other</option>
            </select>
          </label>
          <label class="sct-f sct-f--full"><span>Message</span><textarea name="contact[body]" rows="5" required>{{ form.body }}</textarea></label>
        </div>
        <button type="submit" class="sct-btn">Send message</button>
      {%- endform -%}
    </div>
    <div class="sct-side">
      <h3>Opening hours</h3>
      <p>{{ s.hours }}</p>
      <h3>Address</h3>
      <p>{{ s.address }}</p>
      {%- if s.map != blank -%}<div class="sct-map">{{ s.map }}</div>{%- endif -%}
    </div>
  </section>
</div>

<style>
  .sct{--n:#2A3544;--n2:#1F2833;--iv:#F7EFDF;--g:#C9A45C;--g2:#A8843E;--mut:#5F6877;--line:#E2DACB;--bg:#FBF6EE;background:var(--bg);color:var(--n2);padding-bottom:56px}
  .sct *{box-sizing:border-box}
  .sct-in{max-width:1160px;margin:0 auto;padding:0 16px}
  .sct-kick{margin:0 0 10px;font-size:11px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:#D8B66E}
  .sct-kick--dark{color:var(--g2)}
  .sct-h1,.sct-h2{font-family:'Playfair Display',Georgia,serif;font-weight:500;line-height:1.15;margin:0}
  .sct-h1{font-size:32px;color:var(--iv)}
  .sct-h2{font-size:24px;color:var(--n2);margin-bottom:12px}
  .sct-hero{background:radial-gradient(120% 140% at 50% 0%,#3A4960 0%,#2A3544 50%,#1F2833 100%);padding:44px 0 72px;text-align:center;border-bottom:3px solid var(--g)}
  .sct-lead{max-width:620px;margin:14px auto 0;font-size:16px;line-height:1.6;color:#D5D9E0}
  .sct-cards{display:grid;gap:12px;margin-top:-40px;position:relative}
  .sct-card{display:grid;grid-template-columns:44px 1fr;column-gap:14px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:14px;padding:16px;text-decoration:none!important;color:var(--n2)!important;box-shadow:0 10px 24px rgba(31,40,51,.08);transition:transform .2s,box-shadow .2s}
  .sct-card:hover{transform:translateY(-2px);box-shadow:0 14px 30px rgba(31,40,51,.12)}
  .sct-ic{grid-row:span 3;display:grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#F1ECE2;color:var(--n);border:1px solid var(--line)}
  .sct-card b{font-family:'Playfair Display',Georgia,serif;font-size:18px;font-weight:600}
  .sct-card span{font-size:15px;color:#3A4556;line-height:1.45}
  .sct-break{word-break:break-word}
  .sct-card em{font-style:normal;font-size:13px;color:var(--g2);margin-top:2px}
  .sct-card--main{background:var(--n);border-color:var(--n);color:var(--iv)!important}
  .sct-card--main span{color:#E6E9EE}.sct-card--main em{color:#D8B66E}
  .sct-card--main .sct-ic{background:#25D366;color:#fff;border-color:#25D366}
  .sct-help{display:grid;gap:16px;margin-top:40px}
  .sct-box{background:#F1ECE2;border:1px solid var(--line);border-radius:14px;padding:22px 20px}
  .sct-box ul{list-style:none;margin:0 0 14px;padding:0}
  .sct-box li{position:relative;padding-left:22px;margin:0 0 9px;font-size:15px;line-height:1.5;color:#3A4556}
  .sct-box li::before{content:"";position:absolute;left:2px;top:7px;width:7px;height:7px;background:var(--g);transform:rotate(45deg)}
  .sct-link{display:inline-flex;align-items:center;min-height:44px;font-weight:600;color:var(--n)!important;text-decoration:underline;text-underline-offset:4px;text-decoration-color:var(--g)}
  .sct-formwrap{display:grid;gap:20px;margin-top:40px}
  .sct-formcard{background:#fff;border:1px solid var(--line);border-radius:16px;padding:24px 18px;box-shadow:0 12px 28px rgba(31,40,51,.06)}
  .sct-sub{margin:0 0 18px;color:var(--mut);font-size:15px}
  .sct-grid{display:grid;gap:14px}
  .sct-f{display:flex;flex-direction:column;gap:6px;font-size:14px;font-weight:600;color:var(--n2)}
  .sct-f input,.sct-f select,.sct-f textarea{width:100%;font:inherit;font-weight:400;font-size:16px;color:var(--n2);background:#FFFCF7;border:1px solid #D9D2C4;border-radius:10px;padding:13px 14px;min-height:50px}
  .sct-f textarea{min-height:130px;resize:vertical}
  .sct-f input:focus,.sct-f select:focus,.sct-f textarea:focus{outline:none;border-color:var(--n);box-shadow:0 0 0 3px rgba(42,53,68,.12)}
  .sct-btn{margin-top:16px;width:100%;min-height:52px;border:0;border-radius:10px;background:var(--n);color:#fff;font-size:16px;font-weight:700;cursor:pointer;transition:background .2s}
  .sct-btn:hover{background:#1E2733}
  .sct-ok{background:#EAF4EC;color:#1F5130;border:1px solid #BFDCC7;border-radius:10px;padding:12px 14px;margin:0 0 14px}
  .sct-err{background:#FBEAEA;color:#7A1F1F;border:1px solid #EBC3C3;border-radius:10px;padding:12px 14px;margin:0 0 14px}
  .sct-side h3{font-family:'Playfair Display',Georgia,serif;font-size:19px;font-weight:600;margin:0 0 6px}
  .sct-side p{margin:0 0 18px;font-size:15px;line-height:1.6;color:#3A4556}
  .sct-map{border-radius:14px;overflow:hidden;border:1px solid var(--line)}
  .sct-map iframe{display:block;width:100%!important;height:260px!important;border:0}
  @media (min-width:750px){
    .sct-hero{padding:68px 0 104px}
    .sct-h1{font-size:46px}
    .sct-h2{font-size:30px}
    .sct-lead{font-size:18px}
    .sct-cards{grid-template-columns:repeat(2,1fr);gap:16px;margin-top:-60px}
    .sct-help{grid-template-columns:1fr 1fr;gap:20px;margin-top:56px}
    .sct-formwrap{grid-template-columns:1.4fr 1fr;gap:32px;margin-top:56px;align-items:start}
    .sct-formcard{padding:32px}
    .sct-grid{grid-template-columns:1fr 1fr}
    .sct-f--full{grid-column:1/-1}
    .sct-btn{width:auto;padding:0 36px}
  }
  @media (min-width:1100px){.sct-cards{grid-template-columns:repeat(4,1fr)}.sct-card{grid-template-columns:1fr}.sct-ic{grid-row:auto;margin-bottom:10px}}
</style>

{% schema %}
{
  "name": "Sufias Contact page",
  "settings": [
    {"type": "text", "id": "title", "label": "Heading", "default": "We are here to help"},
    {"type": "textarea", "id": "lead", "label": "Intro", "default": "Questions about wholesale orders, prices, delivery or selling on Sufias? Message us on WhatsApp for the fastest reply, or use the form below."},
    {"type": "text", "id": "whatsapp", "label": "WhatsApp / phone", "default": "+92 301 4509210"},
    {"type": "text", "id": "email", "label": "Email", "default": "sufiasfashionofficial@gmail.com"},
    {"type": "text", "id": "address", "label": "Address", "default": "Plot 500, Pindi Stop, Maulana Shaukat Ali Road, Kot Lakhpat, Lahore 54000"},
    {"type": "text", "id": "hours", "label": "Opening hours", "default": "Monday to Saturday, 9 am to 10 pm"},
    {"type": "url", "id": "maps_link", "label": "Google Maps link"},
    {"type": "html", "id": "map", "label": "Map embed code"}
  ],
  "presets": [{"name": "Sufias Contact page"}]
}
{% endschema %}
