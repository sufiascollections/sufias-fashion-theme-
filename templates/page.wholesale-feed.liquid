{% layout none %}
{% paginate collections.all.products by 250 %}
{"products":[{% assign feed_comma = false %}{% for p in collections.all.products %}{% if p.tags contains 'booking' %}{% if feed_comma %},{% endif %}{% assign feed_comma = true %}{% assign is_preview = false %}{% if p.tags contains 'preview' %}{% assign is_preview = true %}{% endif %}{"id":{{ p.id | append: '' | json }},"title":{{ p.title | json }},"handle":{{ p.handle | json }},"image":{% if p.featured_image %}{{ p.featured_image | image_url: width: 700 | json }}{% else %}null{% endif %},"preview":{{ is_preview | json }},"launchAt":{{ p.metafields.custom.launch_date_time.value | json }},"type":{{ p.type | json }},"options":{{ p.options | json }},"images":[{% unless is_preview %}{% for img in p.images limit: 8 %}{{ img | image_url: width: 1100 | json }}{% unless forloop.last %},{% endunless %}{% endfor %}{% endunless %}],"description":{% if is_preview %}""{% else %}{{ p.description | replace: '<br>', '¶' | replace: '<br/>', '¶' | replace: '<br />', '¶' | replace: '</p>', '¶' | replace: '</li>', '¶' | strip_html | strip | truncate: 1500 | json }}{% endif %},"variants":[{% for v in p.variants %}{"id":{{ v.id | append: '' | json }},"title":{{ v.title | json }},"available":{{ v.available | json }},"options":{{ v.options | json }},"image":{% if v.featured_image and is_preview == false %}{{ v.featured_image | image_url: width: 1100 | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]}{% endif %}{% endfor %}],"hasNextPage":{% if paginate.next %}true{% else %}false{% endif %}}
{% endpaginate %}
