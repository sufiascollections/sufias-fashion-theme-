{%- comment -%}
  Sufias announcement banner, shown on the homepage right below the hero. Text, link and photos: Theme settings > Sufias wholesale.
{%- endcomment -%}
{%- assign show = settings.sufias_promo_enable -%}{%- if place != 'home' -%}{%- assign show = false -%}{%- endif -%}
{%- if show -%}
{%- liquid
  assign link = settings.sufias_promo_link | default: '/pages/booking'
  assign img1 = settings.sufias_promo_img1
  assign img2 = settings.sufias_promo_img2
  assign kicker = settings.sufias_promo_kicker
  assign t1 = settings.sufias_promo_title | default: 'Wholesale'
  assign t2 = settings.sufias_promo_title2 | default: 'Launch'
  assign dline = settings.sufias_promo_date | default: 'Starts 1 Dec · Min. 12 suits per order'
  assign btn = settings.sufias_promo_button | default: 'Shop now'
-%}
<div class="spb-wrap">
  <a class="spb" href="{{ link }}" aria-label="{{ t1 }} {{ t2 }}. {{ dline }}. {{ btn }}">
    <span class="spb-pic spb-pic--l" aria-hidden="true">
      {%- if img1 != blank -%}
        {{ img1 | image_url: width: 300 | image_tag: alt: '', width: 180, height: 240, loading: 'lazy', sizes: '140px', widths: '150,300' }}
      {%- else -%}
        <img src="{{ 'sufias-promo-left.jpg' | asset_url }}" alt="" width="480" height="640" loading="lazy">
      {%- endif -%}
    </span>
    <span class="spb-mid">
      {%- if kicker != blank -%}<span class="spb-kicker">{{ kicker }}</span>{%- endif -%}
      <span class="spb-title">{{ t1 }} <em>{{ t2 }}</em></span>
      <span class="spb-rule" aria-hidden="true"><i></i></span>
      <span class="spb-date">{{ dline }}</span>
    </span>
    <span class="spb-cta" aria-hidden="true"><span class="spb-btn">{{ btn }}<svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 10h12M11 5l5 5-5 5"/></svg></span></span>
    <span class="spb-pic spb-pic--r" aria-hidden="true">
      {%- if img2 != blank -%}
        {{ img2 | image_url: width: 300 | image_tag: alt: '', width: 180, height: 240, loading: 'lazy', sizes: '140px', widths: '150,300' }}
      {%- else -%}
        <img src="{{ 'sufias-promo-right.jpg' | asset_url }}" alt="" width="480" height="640" loading="lazy">
      {%- endif -%}
    </span>
  </a>
</div>
<style>
  .spb-wrap{max-width:1200px;margin:36px auto 22px;padding:0 16px}
  .spb{position:relative;display:grid;grid-template-columns:64px minmax(0,1fr) 64px;grid-template-areas:"l m r" "l c r";align-items:center;column-gap:10px;padding:14px 12px;border-radius:16px;
    text-decoration:none!important;color:#F7EFDF;isolation:isolate;
    background:radial-gradient(120% 160% at 50% 0%,#3A4960 0%,#2A3544 48%,#1F2833 100%);box-shadow:0 14px 34px rgba(31,40,51,.2)}
  .spb::after{content:"";position:absolute;inset:6px;border:1px solid rgba(216,182,110,.45);border-radius:11px;pointer-events:none}
  .spb-pic{position:relative;display:block;aspect-ratio:3/4;border-radius:999px 999px 10px 10px;overflow:hidden;
    box-shadow:0 0 0 1px rgba(216,182,110,.75),0 0 0 4px rgba(42,53,68,1),0 0 0 5px rgba(216,182,110,.35),0 8px 18px rgba(0,0,0,.3)}
  .spb-pic--l{grid-area:l}.spb-pic--r{grid-area:r}
  .spb-pic img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center top}
  .spb-mid{grid-area:m;text-align:center;min-width:0;padding:4px 0 2px}
  .spb-kicker{display:block;font-size:8.5px;font-weight:600;letter-spacing:.12em;white-space:nowrap;text-transform:uppercase;color:#D8B66E;margin-bottom:6px}
  .spb-title{display:block;font-family:'Playfair Display',Georgia,serif;font-weight:500;font-size:23px;line-height:1.1;color:#F7EFDF;letter-spacing:.01em}
  .spb-title em{font-style:italic;color:#E2C27E}
  .spb-rule{display:flex;align-items:center;justify-content:center;gap:8px;margin:8px auto 7px;width:110px}
  .spb-rule::before,.spb-rule::after{content:"";flex:1;height:1px;background:linear-gradient(90deg,transparent,rgba(216,182,110,.85))}
  .spb-rule::after{background:linear-gradient(90deg,rgba(216,182,110,.85),transparent)}
  .spb-rule i{width:5px;height:5px;background:#D8B66E;transform:rotate(45deg)}
  .spb-date{display:block;font-size:11.5px;letter-spacing:.05em;color:#D5D9E0;line-height:1.35}
  .spb-cta{grid-area:c;justify-self:center;margin:10px 0 2px}
  .spb-btn{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:0 18px;border-radius:6px;background:#F6EEDF;color:#1F2833;
    font-family:'Playfair Display',Georgia,serif;font-weight:600;font-size:15px;letter-spacing:.01em;box-shadow:0 6px 16px rgba(0,0,0,.28);transition:background .2s,transform .2s}
  .spb-btn svg{transition:transform .2s}
  .spb:hover .spb-btn{background:#fff;transform:translateY(-1px)}
  .spb:hover .spb-btn svg{transform:translateX(3px)}
  .spb:focus-visible{outline:2px solid #C9A45C;outline-offset:3px}
  @media (min-width:750px){
    .spb-wrap{margin:52px auto 32px}
    .spb{grid-template-columns:118px minmax(0,1fr) auto 118px;grid-template-areas:"l m c r";column-gap:28px;padding:18px 26px}
    .spb::after{inset:8px;border-radius:12px}
    .spb-kicker{font-size:11px;letter-spacing:.26em;margin-bottom:8px}
    .spb-title{font-size:36px}
    .spb-rule{width:150px;margin:10px auto 9px}
    .spb-date{font-size:14px}
    .spb-cta{margin:0}
    .spb-btn{min-height:50px;padding:0 26px;font-size:17px}
  }
  @media (min-width:1100px){
    .spb{grid-template-columns:132px minmax(0,1fr) auto 132px;column-gap:40px;padding:20px 32px}
    .spb-title{font-size:42px}
  }
</style>
{%- endif -%}
