{%- comment -%}
  Sufias announcement banner, shown on the homepage right below the hero. Text, link and photos: Theme settings > Sufias wholesale.
{%- endcomment -%}
{%- assign show = settings.sufias_promo_enable -%}{%- if place != 'home' -%}{%- assign show = false -%}{%- endif -%}
{%- if show -%}
{%- liquid
  assign link = settings.sufias_promo_link | default: '/pages/booking'
  assign img1 = settings.sufias_promo_img1
  assign img2 = settings.sufias_promo_img2
  assign kicker = settings.sufias_promo_kicker
  assign t1 = settings.sufias_promo_title | default: 'Wholesale'
  assign t2 = settings.sufias_promo_title2 | default: 'Launch'
  assign dline = settings.sufias_promo_date | default: 'Starts 1 Dec · Min. 12 suits per order'
  assign btn = settings.sufias_promo_button | default: 'Shop now'
  assign btn_words = btn | split: ' '
-%}
<div class="spb-wrap">
  <a class="spb" href="{{ link }}" aria-label="{{ t1 }} {{ t2 }}. {{ dline }}. {{ btn }}">
    <span class="spb-glow" aria-hidden="true"></span>
    <span class="spb-pic spb-pic--l" aria-hidden="true">
      {%- if img1 != blank -%}
        {{ img1 | image_url: width: 300 | image_tag: alt: '', width: 180, height: 240, loading: 'lazy', class: 'spb-img', sizes: '130px', widths: '150,300' }}
      {%- else -%}
        <img class="spb-img" src="{{ 'sufias-promo-left.jpg' | asset_url }}" alt="" width="480" height="640" loading="lazy">
      {%- endif -%}
    </span>
    <span class="spb-mid">
      {%- if kicker != blank -%}<span class="spb-kicker">{{ kicker }}</span>{%- endif -%}
      <span class="spb-title"><span class="spb-t1">{{ t1 }}</span> <span class="spb-t2">{{ t2 }}</span></span>
      <span class="spb-date">{{ dline }}</span>
    </span>
    <span class="spb-pic spb-pic--r" aria-hidden="true">
      {%- if img2 != blank -%}
        {{ img2 | image_url: width: 300 | image_tag: alt: '', width: 180, height: 240, loading: 'lazy', class: 'spb-img', sizes: '130px', widths: '150,300' }}
      {%- else -%}
        <img class="spb-img" src="{{ 'sufias-promo-right.jpg' | asset_url }}" alt="" width="480" height="640" loading="lazy">
      {%- endif -%}
    </span>
    <span class="spb-btn" aria-hidden="true"><span>{% for w in btn_words %}<b>{{ w }}</b>{% unless forloop.last %} {% endunless %}{% endfor %}</span></span>
  </a>
</div>
<style>
  .spb-wrap{max-width:1200px;margin:34px auto 18px;padding:0 16px}
  .spb{position:relative;display:grid;grid-template-columns:auto 1fr auto auto;align-items:center;gap:8px;min-height:104px;padding:0 10px 0 0;border-radius:22px;text-decoration:none!important;color:#FFF8EC;
    background:linear-gradient(100deg,#6E4826 0%,#8B5E34 38%,#A97540 62%,#7A5130 100%);box-shadow:0 10px 28px rgba(110,72,38,.22);overflow:visible;isolation:isolate}
  .spb::before{content:"";position:absolute;left:50%;top:-12px;transform:translateX(-50%);width:min(46%,520px);height:60px;border-radius:50% 50% 0 0/100% 100% 0 0;background:#7F5530;z-index:-1}
  .spb-glow{position:absolute;inset:0;border-radius:22px;overflow:hidden;z-index:-1;
    background:repeating-linear-gradient(120deg,transparent 0 34px,rgba(201,162,78,.14) 34px 37px,transparent 37px 90px),radial-gradient(60% 120% at 50% 0%,rgba(242,214,150,.35),transparent 70%)}
  .spb-pic{position:relative;align-self:end;display:block;width:62px;height:100px;margin-top:-14px}
  .spb-pic--l{margin-left:10px}
  .spb-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top;border-radius:16px 16px 0 0;border:2px solid rgba(242,214,150,.7);border-bottom:0;
    -webkit-mask-image:linear-gradient(#000 78%,transparent);mask-image:linear-gradient(#000 78%,transparent)}
    .spb-mid{text-align:center;padding:10px 0;min-width:0}
  .spb-kicker{display:block;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:#F2D696;margin-bottom:2px}
  .spb-title{display:block;font-family:'Playfair Display',Georgia,serif;font-weight:700;line-height:1;font-size:20px;text-transform:uppercase;letter-spacing:.02em}
  .spb-t1{color:#F2D696;text-shadow:0 0 18px rgba(242,214,150,.55)}
  .spb-t2{color:#FFF8EC}
  .spb-date{display:block;margin-top:6px;font-size:11.5px;font-weight:600;letter-spacing:.04em;color:#FFF1DA;line-height:1.3}
  .spb-btn{display:grid;place-items:center;width:58px;height:58px;border-radius:50%;text-align:center;
    background:radial-gradient(circle at 35% 30%,#FBE7B5,#E2BE6E 55%,#C9A24E);color:#4A3017;font-weight:800;font-size:11px;line-height:1.05;text-transform:uppercase;letter-spacing:.03em;
    box-shadow:0 0 0 5px rgba(251,231,181,.28),0 6px 14px rgba(0,0,0,.22);transition:transform .2s}
  .spb:hover .spb-btn{transform:scale(1.06)}
  .spb{grid-template-columns:62px 1fr 62px;grid-template-areas:"l m r" "l b r";row-gap:0;padding:0 8px}
  .spb-pic--l{grid-area:l;margin-left:2px}.spb-pic--r{grid-area:r}.spb-mid{grid-area:m;padding:12px 0 6px}
  .spb-kicker{display:none}
  .spb-btn{grid-area:b;justify-self:center;width:auto;height:auto;min-height:34px;padding:0 18px;margin:0 0 12px;border-radius:999px;box-shadow:0 0 0 3px rgba(251,231,181,.28),0 4px 10px rgba(0,0,0,.2)}
  .spb-btn b{font-weight:800}
  .spb-date{font-size:11px;margin-top:5px}
  @media (min-width:750px){
    .spb{grid-template-columns:auto 1fr auto auto;grid-template-areas:"l m r b";padding:0 22px 0 0}
    .spb-pic--l{margin-left:28px}
    .spb-kicker{display:block}
    .spb-btn{width:92px;height:92px;padding:0;margin:0;border-radius:50%}
    .spb-btn b{display:block}
  }
  @media (min-width:750px){
    .spb-wrap{margin:48px auto 28px}
    .spb{min-height:128px;gap:18px;padding-right:22px}
    .spb::before{top:-18px;height:80px}
    .spb-pic{width:110px;height:150px;margin-top:-26px}
    .spb-pic--l{margin-left:28px}
    .spb-kicker{font-size:12px}
    .spb-title{font-size:40px}
    .spb-date{font-size:15px;margin-top:8px}
    .spb-btn{width:92px;height:92px;font-size:16px;box-shadow:0 0 0 7px rgba(251,231,181,.28),0 8px 18px rgba(0,0,0,.22)}
  }
  @media (min-width:1100px){
    .spb-title{font-size:48px}
    .spb-pic{width:128px;height:170px}
  }
</style>
{%- endif -%}
